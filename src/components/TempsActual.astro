---
import type { Llengua } from '../i18n/ui.ts';
const { llengua } = Astro.props as { llengua: Llengua };
const missatge = llengua === 'ca' ? 'Temps a Súria no disponible · MET Norway' : 'Tiempo en Súria no disponible · MET Norway';
---
<span class="temps" role="img" data-temps data-llengua={llengua} aria-label={missatge} title={missatge}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-temps-icona></svg>
  <span data-temps-valor>— °C</span>
</span>
<script>import '../scripts/temps.ts';</script>
<style>
  .temps { display: inline-flex; align-items: center; justify-content: flex-end; gap: .4rem; min-height: var(--tap); min-width: 5.25rem; color: var(--calc); font: 600 var(--t-meta)/1.2 var(--display); white-space: nowrap; text-decoration: none; }
  svg { width: 1.4rem; height: 1.4rem; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  svg:empty { visibility: hidden; }
</style>
