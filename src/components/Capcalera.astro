---
// Capçalera: a dalt, la franja de servei (avís d'independència, data d'avui a Súria i llengua);
// després, a la portada, la foto del poble a tota amplada amb el nom al cel; a la resta, la marca compacta.
// Les tasques, sempre sobre un filet.
import NavTasques from './NavTasques.astro';
import SelectorLlengua from './SelectorLlengua.astro';
import FotoSuria from './FotoSuria.astro';
import { fotos } from '../lib/fotos.ts';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe, type Pagina } from '../i18n/rutes.ts';

interface Props {
  llengua: Llengua;
  pagina: Pagina | null;
  urlsLlengua: Record<Llengua, string>;
}
const { llengua, pagina, urlsLlengua } = Astro.props;
const t = traductor(llengua);
const esInici = pagina === 'inici';
---
<header class:list={['capcalera', { inici: esInici }]}>
  <div class="barra">
    <div class="ample barra-dins">
      <p class="avis"><strong>{t('avis.fort')}</strong>{t('avis.resta')}</p>
      <div class="servei">
        <time class="avui" data-avui data-llengua={llengua}></time>
        <SelectorLlengua llengua={llengua} urls={urlsLlengua} />
      </div>
    </div>
  </div>
  {
    esInici ? (
      <div class="escena">
        <h1 class="marca">
          {t('lloc.nom')}
          <span class="visually-hidden"> ({t('avis.fort').toLowerCase()})</span>
        </h1>
        <FotoSuria foto={fotos.vista} llengua={llengua} format="escena" sizes="100vw" prioritaria />
        <div class="ample">
          <NavTasques llengua={llengua} actual={pagina} />
        </div>
      </div>
    ) : (
      <div class="ample mast">
        <a class="marca" href={urlDe('inici', llengua)} aria-label={t('lloc.inici')}>
          {t('lloc.nom')}
        </a>
        <NavTasques llengua={llengua} actual={pagina} />
      </div>
    )
  }
</header>

<script>
  // Data d'avui a Súria. Sense JavaScript, simplement no apareix (mai una data inventada).
  import { dataMadrid } from '../lib/hora-local.ts';
  import { dataCompleta } from '../lib/format.ts';

  for (const el of document.querySelectorAll<HTMLTimeElement>('[data-avui]')) {
    const avui = dataMadrid(new Date());
    el.textContent = dataCompleta(avui, el.dataset.llengua === 'es' ? 'es' : 'ca');
    el.dateTime = avui;
  }
</script>

<style>
  .barra {
    background: var(--tinta);
    color: var(--calc);
    font-size: var(--t-meta);
    line-height: 1.4;
  }
  .barra-dins {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-5);
    padding-block: var(--s-1);
  }
  .avis {
    padding-block: var(--s-2);
  }
  .avis strong {
    font-weight: 700;
    color: var(--ocre);
  }
  .servei {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-left: auto;
  }
  .avui {
    font-family: var(--display);
    font-weight: 600;
  }
  @media (max-width: 56.25rem) {
    /* La data es parteix en dues línies abans que la llengua baixi a una fila pròpia. */
    .avui {
      flex: 1 1 10rem;
      min-width: 0;
    }
  }
  .avui:empty {
    display: none;
  }
  .barra :global(:focus-visible) {
    outline-color: var(--ocre);
  }

  /* Portada: el nom ocupa tota l'amplada (Lentos). Resta: marca compacta i tasques a la mateixa línia. */
  .mast {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    column-gap: var(--s-6);
    padding-top: var(--s-4);
  }
  .marca {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-variation-settings: 'wdth' 82;
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    text-decoration: none;
    color: var(--tinta);
    padding-bottom: var(--s-3);
  }
  a.marca:hover {
    color: var(--tinta);
  }
  /* Portada: el nom de Súria al cel de la foto, a tota amplada. */
  .escena {
    position: relative;
  }
  .escena .marca {
    position: absolute;
    z-index: 1;
    top: clamp(0.75rem, 2.2vw, 2rem);
    left: max(var(--pad), calc((100% - var(--amplada)) / 2 + var(--pad)));
    font-size: clamp(4.5rem, 13vw, 12rem);
    font-variation-settings: 'wdth' 90;
    line-height: 0.8;
    letter-spacing: -0.05em;
    margin-left: -0.04em;
    padding: 0;
    pointer-events: none;
  }
  /* Crèdit de la foto: a sota al mòbil; a l'escriptori, sobre la part baixa de la foto, sense tapar el nom. */
  .escena :global(figcaption) {
    padding: 0 var(--pad);
  }
  @media (max-width: 56.25rem) {
    .escena .marca {
      font-size: clamp(4rem, 18vw, 6rem);
      top: 0.5rem;
    }
    .escena :global(figcaption) {
      padding-top: var(--s-1);
    }
  }
  @media (min-width: 56.3rem) {
    .escena :global(.foto) {
      position: relative;
    }
    .escena :global(figcaption) {
      position: absolute;
      right: 0;
      bottom: 0;
      padding: 0 var(--s-4);
      background: rgb(29 37 50 / 0.78);
      color: var(--calc);
      border-top-left-radius: var(--radi);
    }
    .escena :global(figcaption a) {
      color: var(--calc);
      padding-block: 0.7rem;
    }
    .escena :global(figcaption a:hover) {
      color: var(--ocre);
    }
    .escena :global(figcaption a:focus-visible) {
      outline-color: var(--ocre);
      outline-offset: -3px;
    }
  }
  .escena :global(.tasques) {
    margin-top: var(--s-3);
  }
  @media (max-width: 56.25rem) {
    .mast {
      grid-template-columns: minmax(0, 1fr);
    }
    .barra-dins {
      font-size: var(--t-tag);
    }
    /* Al mòbil: l'avís a dalt i, a sota, la data a l'esquerra i la llengua a la dreta. */
    .servei {
      width: 100%;
      justify-content: space-between;
    }
    /* A la portada no hi ha data a la franja: la llengua puja al costat de l'avís. */
    .inici .barra-dins {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
    .inici .servei {
      width: auto;
    }
    /* A la portada, la data ja és a la salutació. */
    .inici .avui {
      display: none;
    }
  }
</style>
