---
// Capçalera: a dalt, la franja de servei (avís d'independència i data d'avui a Súria); després la marca,
// les tasques i la llengua sobre fons clar, com fa Lentos (la marca més gran a la portada) i, a la portada, la foto del poble
// a tota amplada, neta, amb el seu crèdit a sota.
import NavTasques from './NavTasques.astro';
import SelectorLlengua from './SelectorLlengua.astro';
import FotoSuria from './FotoSuria.astro';
import { fotos } from '../lib/fotos.ts';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe, type Pagina } from '../i18n/rutes.ts';

interface Props {
  llengua: Llengua;
  pagina: Pagina | null;
  urlsLlengua: Record<Llengua, string>;
}
const { llengua, pagina, urlsLlengua } = Astro.props;
const t = traductor(llengua);
const esInici = pagina === 'inici';
---
<header class:list={['capcalera', { inici: esInici }]}>
  <div class="barra">
    <div class="ample barra-dins">
      <p class="avis"><strong>{t('avis.fort')}</strong>{t('avis.resta')}</p>
      <time class="avui" data-avui data-llengua={llengua}></time>
    </div>
  </div>
  <div class="ample mast">
    {
      esInici ? (
        <h1 class="marca">
          {t('lloc.nom')}
          <span class="visually-hidden"> ({t('avis.fort').toLowerCase()})</span>
        </h1>
      ) : (
        <a class="marca" href={urlDe('inici', llengua)} aria-label={t('lloc.inici')}>
          {t('lloc.nom')}
        </a>
      )
    }
    <NavTasques llengua={llengua} actual={pagina} />
    <SelectorLlengua llengua={llengua} urls={urlsLlengua} />
  </div>
  {esInici && <FotoSuria foto={fotos.vista} llengua={llengua} format="escena" sizes="100vw" prioritaria />}
</header>

<script>
  // Data d'avui a Súria. Sense JavaScript, simplement no apareix (mai una data inventada).
  import { dataMadrid } from '../lib/hora-local.ts';
  import { dataCompleta } from '../lib/format.ts';

  for (const el of document.querySelectorAll<HTMLTimeElement>('[data-avui]')) {
    const avui = dataMadrid(new Date());
    el.textContent = dataCompleta(avui, el.dataset.llengua === 'es' ? 'es' : 'ca');
    el.dateTime = avui;
  }
</script>

<style>
  .barra {
    background: var(--tinta);
    color: var(--calc);
    font-size: var(--t-meta);
    line-height: 1.4;
  }
  .barra-dins {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-5);
    padding-block: var(--s-1);
  }
  .avis {
    padding-block: var(--s-2);
  }
  .avis strong {
    font-weight: 700;
    color: var(--ocre);
  }

  .avui {
    font-family: var(--display);
    font-weight: 600;
  }
  @media (max-width: 56.25rem) {
    /* La data es parteix en dues línies abans que la llengua baixi a una fila pròpia. */
    .avui {
      flex: 1 1 10rem;
      min-width: 0;
    }
  }
  /* L'espai de la data queda reservat: quan el script l'escriu, la pàgina no salta. */
  .avui {
    min-height: calc(1.4em + 2 * var(--s-2));
  }
  .avui:empty {
    visibility: hidden;
  }
  .barra :global(:focus-visible) {
    outline-color: var(--ocre);
  }
  .avui {
    padding-block: var(--s-2);
  }

  /* Marca i tasques a la mateixa línia (al mòbil, una sota l'altra), sobre fons clar. */
  .mast {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'marca tasques llengua';
    align-items: end;
    column-gap: var(--s-6);
    padding-top: var(--s-4);
  }
  .marca {
    grid-area: marca;
  }
  .mast > :global(.tasques) {
    grid-area: tasques;
  }
  .mast > :global(.llengua) {
    grid-area: llengua;
    margin-bottom: var(--s-1);
    padding-block: var(--s-1);
    border-top: var(--filet-fort);
  }
  .marca {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-variation-settings: 'wdth' 82;
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    text-decoration: none;
    color: var(--tinta);
    padding-bottom: var(--s-3);
  }
  a.marca:hover {
    color: var(--tinta);
  }
  /* Portada: el nom més gran, al costat de les tasques; la foto, a sota i a tota amplada. */
  .inici .marca {
    font-size: clamp(3.25rem, 7.5vw, 7rem);
    font-variation-settings: 'wdth' 88;
    letter-spacing: -0.05em;
    margin-left: -0.03em;
  }
  .capcalera :global(.escena) {
    margin-top: var(--s-2);
  }
  /* Crèdit de la foto: a sota, en una o dues línies llegibles. Els enllaços, en línia: la zona tàctil de 44 px
     (farciment) no separa les línies. */
  .capcalera :global(.escena figcaption) {
    max-width: var(--amplada);
    margin-inline: auto;
    padding: var(--s-1) var(--pad) 0;
    line-height: 1.6;
    text-align: right;
  }
  .capcalera :global(.escena figcaption a) {
    display: inline;
    padding-block: 0.75rem;
  }
  /* Pantalles mitjanes i mòbil: la marca i la llengua a la primera fila; les tasques, a sota, a tota amplada. */
  @media (max-width: 72rem) {
    .mast {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'marca llengua' 'tasques tasques';
      padding-top: var(--s-3);
    }
    .mast > :global(.llengua) {
      align-self: center;
      margin-bottom: var(--s-2);
      padding-block: 0;
      border-top: 0;
    }
  }
  @media (max-width: 56.25rem) {
    .barra-dins {
      font-size: var(--t-tag);
    }
    /* A la portada, la data ja és al resum d'avui. */
    .inici .avui {
      display: none;
    }
  }
</style>
