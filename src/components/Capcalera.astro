---
// Capçalera: a dalt, la franja de servei (avís d'independència i CA/ES); després la marca i les tasques sobre fons
// clar (la marca més gran a la portada), amb les tasques a una altra fila quan no hi caben còmodament; i, a la portada,
// la foto del poble a tota amplada, neta, amb el seu crèdit a sota. La data només és al resum «Avui a Súria».
import NavTasques from './NavTasques.astro';
import SelectorLlengua from './SelectorLlengua.astro';
import FotoSuria from './FotoSuria.astro';
import { fotos } from '../lib/fotos.ts';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe, type Pagina } from '../i18n/rutes.ts';

interface Props {
  llengua: Llengua;
  pagina: Pagina | null;
  urlsLlengua: Record<Llengua, string>;
}
const { llengua, pagina, urlsLlengua } = Astro.props;
const t = traductor(llengua);
const esInici = pagina === 'inici';
---
<header class:list={['capcalera', { inici: esInici }]}>
  <div class="barra">
    <div class="ample barra-dins">
      <p class="avis"><strong>{t('avis.fort')}</strong>{t('avis.resta')}</p>
      <SelectorLlengua llengua={llengua} urls={urlsLlengua} />
    </div>
  </div>
  <div class="ample mast">
    {
      esInici ? (
        <h1 class="marca">
          {t('lloc.salutacio')}
          <span class="visually-hidden"> ({t('avis.fort').toLowerCase()})</span>
        </h1>
      ) : (
        <a class="marca" href={urlDe('inici', llengua)} aria-label={t('lloc.inici')}>
          {t('lloc.nom')}
        </a>
      )
    }
    <NavTasques llengua={llengua} actual={pagina} />
  </div>
  {esInici && <FotoSuria foto={fotos.vista} llengua={llengua} format="escena" sizes="100vw" prioritaria />}
</header>

<style>
  .barra {
    background: var(--tinta);
    color: var(--calc);
    font-size: var(--t-meta);
    line-height: 1.4;
  }
  .barra-dins {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--s-4);
  }
  /* Franja de servei compacta: l'alçada la marquen els botons d'idioma (44 px, zona tàctil mínima). */
  .avis {
    padding-block: var(--s-1);
  }
  .avis strong {
    font-weight: 700;
    color: var(--ocre);
  }
  .barra :global(:focus-visible) {
    outline-color: var(--ocre);
  }

  /* Marca i tasques: en una fila si hi caben senceres, amb aire entre totes dues; si no, les tasques baixen
     a una fila pròpia a tota amplada. Mai es comprimeixen els noms. */
  .mast {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    column-gap: clamp(2.5rem, 6vw, 6rem);
    row-gap: var(--s-2);
    padding-top: var(--s-4);
  }
  /* La marca es pot partir en dues línies si no hi cap (text ampliat): mai surt de la pantalla. */
  .marca {
    flex: 0 1 auto;
    min-width: 0;
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-variation-settings: 'wdth' 82;
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    text-decoration: none;
    color: var(--tinta);
    padding-bottom: var(--s-3);
  }
  a.marca:hover {
    color: var(--tinta);
  }
  .mast > :global(.tasques) {
    flex: 1 1 auto;
  }
  /* Portada: el nom més gran. */
  .inici .marca {
    font-size: clamp(3.25rem, 7.5vw, 7rem);
    font-variation-settings: 'wdth' 88;
    letter-spacing: -0.05em;
    margin-left: -0.03em;
  }
  /* Crèdit de la foto: dins de la imatge, a baix a la dreta, sobre un fons fosc només darrere del text
     (la foto no s'enfosqueix). Una línia a l'escriptori; dues al mòbil si cal. Els enllaços conserven
     la zona tàctil de 44 px amb farciment en línia, sense fer més alta la franja. */
  /* La foto, a tota amplada i sense cantonades pròpies: el contingut de la pàgina la cobreix per sota amb les
     cantonades superiors corbes (vegeu --solapa a global.css). */
  .capcalera :global(.escena) {
    position: relative;
    margin-top: var(--s-2);
  }
  /* Crèdit: una etiqueta flotant, per sobre de la zona que cobreix el contingut. */
  .capcalera :global(.escena figcaption) {
    position: absolute;
    right: clamp(1.25rem, 3vw, 2.5rem);
    bottom: calc(var(--solapa) + clamp(0.5rem, 1vw, 0.75rem));
    max-width: calc(100% - 2.5rem);
    padding: 0.3rem var(--s-3) 0.35rem;
    background: rgb(29 37 50 / 0.8);
    color: var(--calc);
    border-radius: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: left;
  }
  /* TEMPORAL (prova del 14/10/2026): crèdit amagat a petició del promotor. La llicència CC BY-SA 4.0 exigeix
     l'atribució: s'ha de tornar a mostrar abans d'ensenyar el lloc a ningú més. */
  .capcalera :global(.escena figcaption) {
    display: none;
  }
  .capcalera :global(.escena figcaption a) {
    display: inline;
    padding-block: 0.875rem;
    color: var(--calc);
  }
  .capcalera :global(.escena figcaption a:hover) {
    color: var(--ocre);
  }
  .capcalera :global(.escena figcaption a:focus-visible) {
    outline-color: var(--ocre);
    outline-offset: 1px;
  }
  /* Escriptori (des de 72rem): marca i tasques sempre a la mateixa línia, centrades verticalment.
     Mides fluides perquè hi càpiguen sense partir cap nom, també en castellà. */
  @media (min-width: 72rem) {
    .mast {
      flex-wrap: nowrap;
      align-items: center;
      column-gap: clamp(2rem, 3.5vw, 4rem);
      padding-bottom: var(--s-2);
    }
    .marca,
    .inici .marca {
      padding-bottom: 0;
    }
    .inici .marca {
      font-size: clamp(3.5rem, 5vw, 5rem);
    }
    .mast > :global(.tasques) {
      flex: 1 1 auto;
      margin-bottom: 0;
    }
    .mast > :global(.tasques ul) {
      justify-content: flex-end;
      column-gap: clamp(1rem, 2vw, 2.5rem);
    }
    .mast > :global(.tasques a) {
      font-size: clamp(1.0625rem, 1.35vw, 1.375rem);
    }
  }
  @media (max-width: 56.25rem) {
    .barra-dins {
      font-size: var(--t-tag);
    }
    .mast {
      padding-top: var(--s-3);
    }
    /* Al mòbil, el crèdit en una sola línia: la versió curta, a la mateixa mida de lletra. */
    .capcalera :global(.escena figcaption) {
      right: 1rem;
      bottom: calc(var(--solapa) + 0.5rem);
      max-width: calc(100% - 2rem);
      padding-inline: var(--s-2);
      font-family: var(--display);
    }
    .capcalera :global(.escena .credit) {
      display: none;
    }
    .capcalera :global(.escena .credit-curt) {
      display: inline;
    }
    /* Al mòbil, les tasques sempre a la seva fila (2×2), sota la marca. */
    .mast > :global(.tasques) {
      flex-basis: 100%;
    }
  }
</style>
