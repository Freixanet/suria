---
import { getCollection } from 'astro:content';
import type { Llengua } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';
interface Props { llengua: Llengua; complet?: boolean; }
const { llengua, complet = false } = Astro.props;
const es = llengua === 'es';
const serveis = (await getCollection('informacioPractica')).map((entrada) => entrada.data).sort((a, b) => a.ordre - b.ordre);
const visibles = complet ? serveis : serveis.slice(0, 6);
const Titol = complet ? 'h1' : 'h2';
const icones = {
  document: '<path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6m-6 4h6"/>',
  bus: '<rect x="5" y="3" width="14" height="15" rx="2"/><path d="M5 10h14M8 14h.01M16 14h.01M7 18v3m10-3v3"/>',
  health: '<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/>',
  shield: '<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6zM12 8v5m0 3h.01"/>',
  recycle: '<path d="m8 7 4-5 4 5M12 2v12M5 10l-3 6 6 1m-6-1 9 5m8-11 3 6-6 1m6-1-9 5"/>',
  school: '<path d="m2 8 10-5 10 5-10 5zM6 10v7c4 3 8 3 12 0v-7m4-2v8"/>',
  home: '<path d="m3 11 9-8 9 8M5 10v11h14V10M9 21v-7h6v7"/>',
  care: '<path d="M12 19 4 11C-1 5 7 1 12 7c5-6 13-2 8 4z"/>',
  work: '<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V3h8v4M3 12c5 4 13 4 18 0m-9 1v4"/>',
  receipt: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 7h6m-6 4h6m-6 4h3"/>',
  people: '<circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6m2 4c3 1 3 4 3 7"/>',
  book: '<path d="M12 5C9 3 5 3 2 4v16c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1zm0 0v16"/>',
  drop: '<path d="M12 2S4 11 4 16a8 8 0 0 0 16 0C20 11 12 2 12 2zM8 16a4 4 0 0 0 4 4"/>',
  street: '<path d="M5 21 9 3m6 0 4 18M12 4v3m0 4v3m0 4v3"/>',
  building: '<path d="M4 21V3h16v18M2 21h20M8 7h2m4 0h2M8 11h2m4 0h2m-7 6h6v4"/>',
  welcome: '<circle cx="12" cy="5" r="3"/><path d="m3 10 9 3 9-3M12 13v5m0 0-5 4m5-4 5 4"/>',
};
---
<section class:list={['practica', { completa: complet }]} aria-labelledby="h-practica">
  <header class="practica-cap">
    <div class="practica-intro">
    <Titol id="h-practica" class="titol-gran">{es ? 'Información práctica' : 'Informació pràctica'}</Titol>
    <p>{es ? 'Los servicios y gestiones que necesitas para tu día a día en Súria.' : 'Els serveis i les gestions que necessites per al teu dia a dia a Súria.'}</p>
    </div>
    {!complet && <a class="veure-tot" href={urlDe('practica', llengua)}>{es ? 'Ver todo' : 'Veure tot'} <span aria-hidden="true">→</span></a>}
  </header>
  <ul class="practica-targetes">
    {visibles.map((servei) => (
      <li class="practica-targeta" data-facana={servei.color}>
        <div class="practica-titol">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icones[servei.icona]} />
          <h3>{servei.titol[llengua]}</h3>
        </div>
        <p>{servei.descripcio[llengua]}</p>
        <ul class="practica-enllacos">
          {servei.enllacos.map((enllac) => (
            <li><a href={enllac.url}>{enllac.text[llengua]}<span aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</section>

<style>
  .practica { min-width: 0; }
  .practica-cap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-4) var(--s-6); margin-bottom: var(--s-6); }
  .practica-intro { max-width: 48rem; }
  .veure-tot { flex: none; white-space: nowrap; }
  h1 { font-size: var(--t-h1); line-height: 1.05; margin-bottom: var(--s-4); }
  h2 { font-size: clamp(1.75rem, 2.6vw, 2.375rem); margin-bottom: var(--s-3); }
  .practica-cap p { color: var(--tinta-2); font-size: var(--t-small); }
  .practica-targetes { display: grid; grid-template-columns: repeat(3, minmax(0, 26rem)); gap: var(--s-5); list-style: none; }
  .practica-targeta { display: flex; flex-direction: column; align-items: stretch; gap: var(--s-3); min-width: 0; padding: var(--s-5); background: var(--f-clar); color: var(--tinta); border-radius: 24px; }
  .completa .practica-targetes { grid-template-columns: repeat(4, minmax(0, 26rem)); }
  [data-facana='lavanda'] { --f-clar: #e4dfee; --f-tinta: #59466e; }
  [data-facana='pedra'] { --f-clar: var(--pedra); --f-tinta: var(--tinta-2); }
  .practica-titol { display: flex; gap: var(--s-3); align-items: flex-start; }
  h3 { font-size: 1.375rem; line-height: 1.2; letter-spacing: -.015em; }
  svg { width: 1.5rem; height: 1.5rem; flex: none; color: var(--f-tinta); fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .practica-targeta > p { font-size: 1rem; line-height: 1.5; color: var(--tinta-2); }
  .practica-enllacos { margin-top: auto; padding-top: var(--s-2); list-style: none; }
  a { display: flex; gap: var(--s-3); align-items: center; justify-content: space-between; min-height: var(--tap); padding-block: var(--s-2); font-size: 1rem; line-height: 1.35; font-weight: 600; text-decoration: none; }
  a span { flex: none; color: var(--f-tinta); }
  a:hover { text-decoration: underline; color: var(--tinta); }
  @media (max-width: 79.999rem) { .completa .practica-targetes { grid-template-columns: repeat(3, minmax(0, 26rem)); } }
  @media (max-width: 56.25rem) { .practica-targetes, .completa .practica-targetes { grid-template-columns: repeat(2, minmax(0, 26rem)); gap: var(--s-4); } }
  @media (max-width: 38rem) { .practica-targetes, .completa .practica-targetes { grid-template-columns: minmax(0, 26rem); } }
</style>
