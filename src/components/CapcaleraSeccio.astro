---
// Obertura de secció o de pàgina: primer el títol i, a sota, alineada a l'esquerra, la maduresa en text dins d'un marc,
// seguida del període o la descripció quan n'hi ha. Sempre al mateix lloc a totes les seccions.
import { traductor, type Llengua } from '../i18n/ui.ts';

interface Props {
  id: string;
  titol: string;
  maduresa: 'Real' | 'En prova' | 'Demo' | 'Idea';
  llengua: Llengua;
  nivell?: 1 | 2;
  /** Títol més contingut, per a seccions secundàries. */
  compacte?: boolean;
  /** Informació secundària al costat de la maduresa: el període (agenda) o la descripció (pàgina). */
  detall?: string;
  /** Classe del detall, per estil i proves ('vigencia', 'entrada'). */
  classeDetall?: string;
}
const { id, titol, maduresa, llengua, nivell = 2, compacte = false, detall, classeDetall } = Astro.props;
const Titol = nivell === 1 ? 'h1' : 'h2';
const t = traductor(llengua);
---
<div class="obertura">
  <Titol id={id} class:list={['titol-gran', 'titol-seccio', `n${nivell}`, { compacte }]}>{titol}</Titol>
  <p class="meta">
    <span class:list={['maduresa', { especulativa: maduresa === 'Idea' || maduresa === 'Demo' }]}>{t(`maduresa.${maduresa}`)}</span>
    {detall && <span class={classeDetall}>{detall}</span>}
  </p>
</div>

<style>
  .obertura {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .n2 {
    font-size: var(--t-h2);
  }
  .n1 {
    font-size: var(--t-h1);
  }
  .compacte {
    font-size: clamp(1.75rem, 2.6vw, 2.375rem);
  }
  /* Maduresa i detall com un sol text: si no hi cap, el detall continua a la línia següent de manera natural. */
  .meta {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-small);
    line-height: 1.35;
    color: var(--tinta-2);
  }
  /* «En prova · Del dilluns…»: el punt separa l'etiqueta del detall (Idea i Demo ja tenen el seu marc). */
  .meta > .maduresa {
    display: inline;
    margin-right: 0.3em;
    font-size: inherit;
  }
  .meta > .maduresa.especulativa {
    display: inline-block;
  }
  .meta > .maduresa:not(.especulativa) + span::before {
    content: '· ';
    font-weight: 500;
    color: var(--tinta-2);
  }
  /* La descripció d'una pàgina, a la línia següent de l'etiqueta: és un paràgraf, no una dada. */
  .meta .entrada {
    display: block;
    margin-top: var(--s-2);
  }
  .meta > .maduresa:not(.especulativa) + .entrada::before {
    content: none;
  }
  .meta .entrada {
    font-family: var(--text);
    font-weight: 400;
    font-size: clamp(1.1875rem, 1.6vw, 1.375rem);
    line-height: 1.45;
    color: var(--tinta);
    max-width: 38em;
  }
</style>
