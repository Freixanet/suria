---
// Obertura de secció o de pàgina: títol gran i, al costat, la maduresa en text dins d'un marc.
// La maduresa sempre al mateix lloc, perquè es reconegui d'un cop d'ull a totes les seccions.
import { traductor, type Llengua } from '../i18n/ui.ts';

interface Props {
  id: string;
  titol: string;
  maduresa: 'Real' | 'En prova' | 'Demo' | 'Idea';
  llengua: Llengua;
  nivell?: 1 | 2;
  /** Títol més contingut, per a seccions secundàries. */
  compacte?: boolean;
}
const { id, titol, maduresa, llengua, nivell = 2, compacte = false } = Astro.props;
const Titol = nivell === 1 ? 'h1' : 'h2';
const t = traductor(llengua);
---
<div class="obertura">
  <Titol id={id} class:list={['titol-gran', 'titol-seccio', `n${nivell}`, { compacte }]}>{titol}</Titol>
  <span class="maduresa">{t(`maduresa.${maduresa}`)}</span>
</div>

<style>
  .obertura {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    margin-bottom: var(--s-4);
  }
  .n2 {
    font-size: var(--t-h2);
  }
  .n1 {
    font-size: var(--t-h1);
  }
  .compacte {
    font-size: clamp(1.75rem, 2.6vw, 2.375rem);
  }
  .maduresa {
    translate: 0 -0.2em;
  }
</style>
