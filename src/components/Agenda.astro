---
// E2: l'agenda d'una setmana declarada. Quan la setmana acaba, la pàgina ho diu.
import ActivitatAgenda from './ActivitatAgenda.astro';
import EstatBuit from './EstatBuit.astro';
import type { Activitat } from '../lib/dades.ts';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { rangSetmana } from '../lib/format.ts';
import { instantMadrid, sumaDies } from '../lib/hora-local.ts';

interface Props {
  llengua: Llengua;
  setmana: { inici: string; fi: string };
  activitats: Activitat[];
  detall?: boolean;
  font?: { nom: string; url: string };
  /** El període el mostra l'obertura de la secció (portada): aquí no es repeteix. */
  senseVigencia?: boolean;
}
const { llengua, setmana, activitats, detall = false, senseVigencia = false, font } = Astro.props;
const nivell = detall ? 2 : 3;
const t = traductor(llengua);
const rang = rangSetmana(setmana.inici, setmana.fi, llengua);
const caduca = instantMadrid(sumaDies(setmana.fi, 1), '00:00').toISOString();
---
<div class="agenda" data-caduca={caduca}>
  {!senseVigencia && <p class="vigencia">{rang.charAt(0).toUpperCase() + rang.slice(1)}</p>}
  <div class="caducada" data-avis-caducat hidden role="status">
    <p>{t('setmana.caducada', { setmana: rang })}</p>
    <a class="accio" href="https://www.suria.cat/agenda" hreflang="ca">{t('setmana.agendaMunicipal')}</a>
  </div>
  {
    activitats.length > 0 ? (
      <ul class:list={['llista', { obre: senseVigencia }]}>
        {activitats.map((a) => (
          <ActivitatAgenda activitat={a} llengua={llengua} detall={detall} nivell={nivell} />
        ))}
      </ul>
    ) : (
      <EstatBuit titol={t('setmana.buida')}>
        <a class="accio" href="https://www.suria.cat/agenda" hreflang="ca">{t('setmana.agendaMunicipal')}</a>
      </EstatBuit>
    )
  }
  {activitats.length > 0 && <p data-agenda-esgotada hidden>{llengua === 'ca' ? 'No queden activitats per als dies vinents d’aquesta setmana.' : 'No quedan actividades para los próximos días de esta semana.'}</p>}
  {font && <footer class="agenda-font"><a href={font.url} hreflang="ca" aria-label={`${t('procedencia.font')}: ${font.nom}`}>{font.nom}</a></footer>}
</div>

<style>
  .agenda-font { display:flex; justify-content:flex-end; padding-top: var(--s-2); font-size:var(--t-meta); color:var(--tinta-2); }
  .agenda-font a { display:inline-flex; align-items:center; min-height:var(--tap); }
  .vigencia {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--t-small);
    color: var(--tinta-2);
    padding-bottom: var(--s-3);
    border-bottom: var(--filet-fort);
  }
  .caducada {
    margin-top: var(--s-4);
    --radius: var(--radi);
    --border-width: 0px;
    --padding: max(16px, calc(var(--radius) * 0.75));
    padding: var(--padding);
    background: var(--teula-clar);
    border-radius: var(--radius);
  }
  .caducada p {
    font-weight: 700;
  }
  .llista {
    list-style: none;
  }
  /* Sense la línia de vigència, el filet de tinta obre la llista. */
  .obre {
    border-top: var(--filet-fort);
  }
</style>
