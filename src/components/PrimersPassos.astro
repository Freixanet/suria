---
// E3: primers passos per a qui acaba d'arribar, amb l'acció concreta que ho resol.
// A la portada: on, quan i què cal (resum) i l'acció. A la pàgina de detall: el text sencer i la procedència.
import LiniaProcedencia from './LiniaProcedencia.astro';
import TextHores from './TextHores.astro';
import type { Pas } from '../lib/dades.ts';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';
import { diaLlarg, hora, telefonVisible } from '../lib/format.ts';
import { instantMadrid } from '../lib/hora-local.ts';

interface Props {
  llengua: Llengua;
  passos: Pas[];
  detall?: boolean;
}
const { llengua, passos, detall = false } = Astro.props;
const t = traductor(llengua);
// A la pàgina de tasca (sota l'h1) els passos són h2; a la portada (sota un h2), h3.
const Titol = detall ? 'h2' : 'h3';
const moment = (m: { data: string; hora: string }) => `${diaLlarg(m.data, llengua)}, ${hora(m.hora, llengua)} h`;
// Quan acaba l'últim torn publicat: a partir d'aquí, la pàgina diu que falta informació i porta a la font oficial.
const fiDarrerTorn = (p: Pas) =>
  p.guardies
    .map((g) => instantMadrid(g.finsA.data, g.finsA.hora))
    .sort((a, b) => a.getTime() - b.getTime())
    .at(-1)
    ?.toISOString();
---
<ol class:list={['passos', { portada: !detall }]}>
  {
    passos.map((p) => {
      const text = detall ? p.text : p.resum;
      return (
        <li class="pas" id={p.guardies.length > 0 ? 'farmacia' : undefined}>
          <span class="n" aria-hidden="true">{p.ordre}</span>
          <div>
            <Titol class="titol-peca">{p.titol[llengua]}</Titol>
            {text && <p><TextHores text={text[llengua]} /></p>}
            {detall && p.guardies.length > 0 && (
              <ul class="guardies">
                {p.guardies.map((g, i) => (
                  <li data-caduca={instantMadrid(g.finsA.data, g.finsA.hora).toISOString()}>
                    <span class="quan">
                      {i === 0
                        ? t('passos.guardia.fins', { fi: moment(g.finsA) })
                        : t('passos.guardia.desde', { inici: moment(g.desDe), fi: moment(g.finsA) })}
                    </span>
                    <strong>{g.farmacia}</strong>, {g.adreca}.
                    <span class="acabat" data-avis-caducat hidden>{t('passos.guardia.caducada')}</span>
                    <a class="accio" href={`tel:${g.telefon}`}>
                      {`${g.farmacia.replace(/^Farmàcia /, '')}: `}<span class="xifres">{telefonVisible(g.telefon)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {detall && p.guardies.length > 0 && (
              <div class="sense-torn" data-caduca={fiDarrerTorn(p)}>
                <p data-avis-caducat hidden role="status">
                  <strong>{t('passos.guardia.senseVigent')}</strong>
                  <a class="accio" href={p.fonts[0].url} hreflang="ca">{t('passos.guardia.fontOficial')}</a>
                </p>
              </div>
            )}
            {/* A la portada, el torn vigent és al resum d'avui; aquí, l'enllaç a tots els torns. */}
            {!detall && p.guardies.length > 0 && (
              <div class="accions">
                <a class="accio" href={`${urlDe('passos', llengua)}#farmacia`}>{t('passos.guardia.tots')}</a>
              </div>
            )}
            {p.accions.length > 0 && (
              <div class="accions">
                {p.accions.map((a) =>
                  a.tipus === 'web' ? (
                    <a class="accio" href={a.url} hreflang="ca">{a.text[llengua]}</a>
                  ) : (
                    <a class="accio" href={`tel:${a.telefon}`}>
                      {`${a.text[llengua]}: `}<span class="xifres">{telefonVisible(a.telefon)}</span>
                    </a>
                  ),
                )}
              </div>
            )}
            {detall && (
              <LiniaProcedencia
                llengua={llengua}
                maduresa={p.maduresa ?? 'En prova'}
                fonts={p.fonts}
                consultat={p.consultat}
                responsable={p.responsable}
              />
            )}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  /* Primers passos (Domino Park, «Plan your visit»): el que cal saber, amb l'acció a mà. */
  .passos {
    list-style: none;
  }
  .pas {
    padding-block: var(--s-5) var(--s-6);
    border-bottom: var(--filet-fi);
  }
  .pas:first-child {
    padding-top: var(--s-2);
  }
  .pas:last-child {
    border-bottom: 0;
  }
  .n {
    display: none;
  }
  .titol-peca {
    font-size: var(--t-h3);
    font-weight: 650;
    line-height: 1.2;
    margin-bottom: var(--s-2);
  }
  p {
    max-width: 40rem;
  }
  .guardies {
    list-style: none;
    margin-top: var(--s-3);
    display: grid;
    gap: var(--s-3);
  }
  /* Torn de guàrdia: una fitxa del color del cel, amb el telèfon com a acció principal. */
  .guardies li {
    padding: var(--s-3) var(--s-4) var(--s-2);
    background: var(--cel);
    border-radius: var(--radi);
  }
  .quan {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-small);
    color: var(--cel-tinta);
  }
  .guardies strong {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.25rem;
  }
  .guardies .accio {
    display: flex;
    width: fit-content;
  }
  .guardies li[data-caducat] {
    background: var(--pedra);
    color: var(--tinta-2);
  }
  .guardies li[data-caducat] .quan {
    color: var(--tinta-2);
  }
  /* A la portada, un torn acabat ja no ocupa lloc: queda el vigent (sense JavaScript, es veuen tots dos amb les dates). */
  .portada .guardies li[data-caducat] {
    display: none;
  }
  .acabat {
    display: block;
    font-family: var(--display);
    font-weight: 650;
    font-size: var(--t-tag);
  }
  .sense-torn p {
    margin-top: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--teula-clar);
    border-radius: var(--radi);
  }
  .sense-torn strong {
    display: block;
    font-family: var(--display);
    font-weight: 700;
  }
  .accions {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-5);
    margin-top: var(--s-1);
  }
</style>
