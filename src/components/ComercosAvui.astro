---
// E1: negocis participants i el seu horari comunicat d'avui. Mai «obert ara».
import EstatBuit from './EstatBuit.astro';
import LiniaProcedencia from './LiniaProcedencia.astro';
import type { Comerc } from '../lib/dades.ts';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { diaCurt, franja, hora } from '../lib/format.ts';

interface Props {
  llengua: Llengua;
  comercos: Comerc[];
  detall?: boolean;
}
const { llengua, comercos, detall = false } = Astro.props;
const t = traductor(llengua);
const Titol = detall ? 'h2' : 'h3';
const textos = {
  sense: t('menjar.estat.sense'),
  senseExp: t('menjar.estat.sense.exp'),
  durant: t('menjar.estat.durant'),
  abans: t('menjar.estat.abans'),
  comunicatExp: t('menjar.estat.comunicat.exp'),
  finalitzat: t('menjar.estat.finalitzat'),
  finalitzatExp: t('menjar.estat.finalitzat.exp'),
  cancelat: t('menjar.estat.cancelat'),
  cancelatExp: t('menjar.estat.cancelat.exp'),
};

// Text de reserva sense JavaScript: l'últim missatge rebut, amb el seu dia i hora.
function ultim(c: Comerc): string {
  const m = [...c.confirmacions].sort((a, b) =>
    `${a.rebutA.data}T${a.rebutA.hora}`.localeCompare(`${b.rebutA.data}T${b.rebutA.hora}`),
  ).at(-1);
  if (!m) return t('menjar.capHorari');
  const quan = m.estat === 'cancelat' ? t('menjar.estat.cancelat') : m.inici ? franja(m.inici, m.fi, llengua) : t('menjar.estat.sense');
  return `${diaCurt(m.dataServei, llengua)}, ${quan} (${hora(m.rebutA.hora, llengua)})`;
}
---
{
  comercos.length === 0 ? (
    <EstatBuit titol={t('menjar.buit.titol')}>
      <p>{t('menjar.buit.text')}</p>
      <p>{t('menjar.buit.promesa')}</p>
    </EstatBuit>
  ) : (
    <ul class="comercos" data-comercos data-llengua={llengua} data-textos={JSON.stringify(textos)}>
      {comercos.map((c) => (
        <li class="fitxa" data-confirmacions={JSON.stringify(c.confirmacions)} data-estat="sense-confirmar">
          <Titol class="titol-peca">{c.nom}</Titol>
          <p class="activitat">{c.activitat[llengua]}{c.adreca && ` · ${c.adreca}`}</p>
          <p class="estat" aria-live="polite">
            <strong data-estat-principal>{t('menjar.estat.sense')}</strong>
            <span data-estat-explicacio>{t('menjar.estat.sense.exp')}</span>
          </p>
          <p class="sensejs" data-sense-js>{t('menjar.sensejs', { detall: ultim(c) })}</p>
          {detall && (
            <LiniaProcedencia
              llengua={llengua}
              maduresa={c.maduresa}
              fonts={c.fonts}
              consultat={c.consultat}
              responsable={c.responsable}
            />
          )}
        </li>
      ))}
    </ul>
  )
}

<script>
  import '../scripts/comercos.ts';
</script>

<style>
  /* Comerços (Union Boulangerie): el nom com un rètol, l'ofici i on és; a sota, l'estat amb paraules. */
  .comercos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--s-6) var(--s-5);
  }
  .fitxa {
    padding-top: var(--s-3);
    border-top: 4px solid var(--teula);
  }
  .titol-peca {
    font-variation-settings: 'wdth' 88;
    font-size: clamp(1.5rem, 2.2vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .activitat {
    margin-top: var(--s-1);
    color: var(--tinta-2);
  }
  .sensejs {
    margin-top: var(--s-2);
    font-size: var(--t-small);
  }
  .estat {
    margin-top: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--pedra);
    border-radius: var(--radi);
  }
  .estat strong {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--display);
    font-weight: 700;
  }
  /* Marca de forma (no només color): ple = horari comunicat; buit = sense confirmar; discontinu = avui no. */
  .estat strong::before {
    content: '';
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--tinta-2);
    border-radius: 2px;
  }
  .estat span {
    display: block;
    font-size: var(--t-small);
    color: var(--tinta-2);
  }
  .fitxa[data-estat='durant'] .estat,
  .fitxa[data-estat='abans'] .estat {
    background: var(--teula-clar);
  }
  .fitxa[data-estat='durant'] .estat strong::before,
  .fitxa[data-estat='abans'] .estat strong::before {
    background: var(--teula);
    border-color: var(--teula);
  }
  .fitxa[data-estat='cancelat'] .estat strong::before {
    border-style: dashed;
    border-color: var(--teula-tinta);
  }
  .fitxa[data-estat='finalitzat'] .estat strong::before {
    background: var(--filet);
    border-color: var(--filet);
  }
</style>
