---
import type { Llengua } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';
interface Props { llengua: Llengua; }
const { llengua } = Astro.props;
const textos = {
  ca: {
    titol: 'El teu pròxim pla comença aquí.',
    etiqueta: 'Què vols saber de Súria?',
    placeholder: 'Explica’ns què necessites…',
    boto: 'Pregunta',
    resposta: 'Les preguntes encara no estan disponibles.',
    suggeriments: 'Idees per començar',
    exemples: [
      { etiqueta: 'Què puc fer avui a Súria?', pregunta: 'Què puc fer avui a Súria?' },
      { etiqueta: 'A quina hora surt el pròxim bus cap a Manresa?', pregunta: 'A quina hora surt el pròxim bus cap a Manresa?' },
      { etiqueta: 'Quina farmàcia està de guàrdia avui?', pregunta: 'Quina farmàcia està de guàrdia avui?' },
      { etiqueta: 'Què necessito per empadronar-me?', pregunta: 'Què necessito per empadronar-me a Súria?' },
    ],
  },
  es: {
    titol: 'Tu próximo plan empieza aquí.',
    etiqueta: '¿Qué quieres saber de Súria?',
    placeholder: 'Cuéntanos qué necesitas…',
    boto: 'Preguntar',
    resposta: 'Las preguntas aún no están disponibles.',
    suggeriments: 'Ideas para empezar',
    exemples: [
      { etiqueta: '¿Qué puedo hacer hoy en Súria?', pregunta: '¿Qué puedo hacer hoy en Súria?' },
      { etiqueta: '¿A qué hora sale el próximo bus a Manresa?', pregunta: '¿A qué hora sale el próximo bus de Súria a Manresa?' },
      { etiqueta: '¿Qué farmacia está de guardia hoy?', pregunta: '¿Qué farmacia está de guardia hoy?' },
      { etiqueta: '¿Qué necesito para empadronarme?', pregunta: '¿Qué necesito para empadronarme en Súria?' },
    ],
  },
}[llengua];
---
<section class="hero-preguntes" aria-labelledby="hero-titol">
  <div class="hero-contingut">
    <h2 id="hero-titol">{textos.titol}</h2>
    <div class="composer-grup">
    <form class="composer" action={urlDe('provant', llengua)} aria-labelledby="hero-titol" data-composer data-resposta={textos.resposta}>
      <label class="visually-hidden" for="hero-pregunta">{textos.etiqueta}</label>
      <input id="hero-pregunta" type="text" placeholder={textos.placeholder} required pattern=".*\S.*" maxlength="300" autocomplete="off" aria-describedby="hero-nota" />
      <button type="submit" aria-label={textos.boto}>
        <span>{textos.boto}</span>
      </button>
    </form>
    <div class="suggeriments" role="group" aria-label={textos.suggeriments} data-suggeriments hidden>
      {textos.exemples.map((exemple) => (
        <button type="button" data-pregunta={exemple.pregunta}>{exemple.etiqueta}</button>
      ))}
    </div>
    </div>
    <p class="hero-nota" id="hero-nota" role="status" hidden></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-composer]').forEach((form) => {
    const grups = form.closest('section')?.querySelectorAll<HTMLElement>('[data-suggeriments]');
    const input = form.querySelector<HTMLInputElement>('input');
    if (grups && input) {
      grups.forEach((suggeriments) => {
      suggeriments.hidden = false;
      suggeriments.querySelectorAll<HTMLButtonElement>('[data-pregunta]').forEach((button) => {
        button.addEventListener('click', () => {
          input.value = button.dataset.pregunta ?? '';
          input.dispatchEvent(new Event('input', { bubbles: true }));
          const nota = document.getElementById('hero-nota');
          if (nota) nota.hidden = true;
          input.focus({ preventScroll: true });
        });
      });
      });
    }
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') form.dataset.teclat = 'true';
    });
    form.addEventListener('pointerdown', () => { delete form.dataset.teclat; });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const nota = document.getElementById('hero-nota');
      if (nota) {
        nota.hidden = false;
        nota.textContent = form.dataset.resposta ?? '';
      }
    });
  });
</script>

<style>
  .hero-preguntes {
    position: relative;
    display: grid;
    align-items: center;
    justify-items: start;
    grid-template-columns: minmax(0, 36rem) minmax(0, 1fr);
    column-gap: clamp(2rem, 5vw, 6rem);
    padding: calc(var(--s-8) + var(--s-2)) clamp(1rem, 5vw, 6rem) var(--solapa);
    padding-inline: max(clamp(1rem, 5vw, 6rem), calc((100% - var(--amplada-composicio)) / 2 + var(--pad)));
    background: linear-gradient(90deg, rgb(29 37 50 / .58) 0%, rgb(29 37 50 / .46) 32%, rgb(29 37 50 / .16) 58%, rgb(29 37 50 / .04) 78%);
    color: var(--calc);
  }
  .hero-contingut {
    width: min(100%, 36rem);
    container-type: inline-size;
    display: grid;
    justify-items: start;
    gap: var(--s-5);
    text-align: left;
  }
  h2 {
    max-width: 18ch;
    font: 700 clamp(2rem, 9cqi, 3.5rem)/1.05 var(--display);
    font-variation-settings: 'wdth' 88;
    letter-spacing: -.03em;
    text-wrap: balance;
  }
  .composer {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-1);
    padding-left: var(--s-6);
    border: 2px solid transparent;
    border-radius: 999px;
    background: var(--calc);
    color: var(--tinta);
    box-shadow: 0 12px 32px rgb(29 37 50 / .16);
  }
  .composer[data-teclat]:focus-within { outline: 2px solid var(--calc); outline-offset: 4px; }
  input {
    flex: 1;
    min-width: 0;
    width: 100%;
    min-height: var(--tap);
    border: 0;
    background: transparent;
    color: var(--tinta);
    font: 400 var(--t-body)/1.5 var(--text);
    caret-color: var(--tinta);
    border-radius: var(--radi);
  }
  input::placeholder { color: var(--tinta-2); opacity: 1; }
  /* El clic no dibuixa cap contorn; la navegació amb Tab conserva el focus exterior. */
  input:focus, input:focus-visible { outline: none; }
  .composer button {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-3);
    min-height: 3.25rem;
    min-width: 3.25rem;
    padding: var(--s-3) var(--s-5);
    border: 0;
    border-radius: 999px;
    background: var(--ocre);
    color: var(--tinta);
    font: 650 var(--t-small)/1.2 var(--display);
    cursor: pointer;
  }
  .composer button:hover { background: color-mix(in srgb, var(--ocre) 88%, var(--calc)); }
  .composer button:active { background: var(--ocre); }
  .composer button:focus-visible { outline: 2px solid var(--tinta); outline-offset: 2px; }
  .composer-grup { position: relative; width: 100%; }
  .suggeriments {
    position: absolute;
    top: calc(100% + var(--s-3));
    left: 0;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--s-2);
  }
  .hero-serveis { width: 100%; max-width: 27rem; justify-self: end; padding-bottom: var(--s-5); color: var(--tinta); }
  @media (max-width: 64rem) {
    .hero-preguntes { grid-template-columns: minmax(0, 1fr); align-content: center; row-gap: var(--s-7); }
    .suggeriments { position: static; margin-top: var(--s-3); }
    .hero-serveis { justify-self: start; max-width: 36rem; }
    .hero-nota { margin-top: var(--s-4); }
  }
  .suggeriments[hidden] { display: none; }
  .suggeriments button {
    min-height: 2rem;
    max-width: 100%;
    padding: var(--s-1) var(--s-3);
    border: 1px solid rgb(253 252 250 / .4);
    border-radius: 999px;
    background: rgb(253 252 250 / .78);
    color: var(--tinta);
    font: 400 .875rem/1.25 var(--text);
    cursor: pointer;
  }
  .suggeriments button:hover { background: var(--calc); }
  .suggeriments button:focus-visible { outline: 2px solid var(--calc); outline-offset: 3px; }
  .hero-nota { margin-top: var(--s-8); font-size: var(--t-tag); line-height: 1.45; max-width: 45ch; }
  @media (max-width: 56.25rem) {
    /* Reserva espai sota els controls sense desplaçar-los en afegir files de suggeriments. */
    .hero-preguntes { padding-bottom: calc(var(--solapa) + 7rem); }
  }
  @media (max-width: 35rem) {
    .hero-contingut { gap: var(--s-4); }
    .hero-nota { margin-top: 13rem; }
    .suggeriments { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-1); }
    .composer { padding-left: var(--s-4); }
    input { font-size: var(--t-meta); }
    .composer button { min-width: 3rem; min-height: 3rem; padding: var(--s-3); }
  }
</style>
