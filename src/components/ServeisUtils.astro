---
import { urlDe } from '../i18n/rutes.ts';
import type { Llengua } from '../i18n/ui.ts';
const { llengua, busUrl } = Astro.props as { llengua: Llengua; busUrl?: string };
const es = llengua === 'es';
const serveis = [
  { nom: es ? 'Ayuntamiento' : 'Ajuntament', url:'https://www.suria.cat/', color:'ocre', path:'<path d="m3 9 9-6 9 6H3Zm2 3v7m5-7v7m4-7v7m5-7v7M3 21h18"/>' },
  { nom:'CAP', url:'https://www.suria.cat/cap', color:'turo', path:'<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6Z"/>' },
  { nom:'Biblioteca', url:'https://www.suria.cat/bibliotecapublica', color:'rosa', path:'<path d="M12 5C9 3 5 3 2 4v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1Zm0 0v15M5 8h4m-4 4h4m6-4h4m-4 4h4"/>' },
  { nom:'Correos', url:'https://www.correos.es/es/es/herramientas/oficinas-buzones-citypaq', color:'llimona', path:'<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/>' },

  { nom: es ? 'Padrón' : 'Padró', url: `${urlDe('passos', llengua)}#empadronament`, color:'lavanda', path:'<path d="M5 21V4h14v17M3 21h18M9 21v-5h6v5M8 8h1m6 0h1M8 12h1m6 0h1"/>' },
  { nom: es ? 'Muebles y poda' : 'Mobles i poda', url: `${urlDe('passos', llengua)}#mobles-i-poda`, color:'teula', path:'<path d="M6 12V7a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v5M5 10a2 2 0 0 0-2 2v6h18v-6a2 2 0 0 0-4 0v3H7v-3a2 2 0 0 0-2-2ZM5 18v3m14-3v3"/>' },
  { nom: es ? 'Farmacias' : 'Farmàcies', url: `${urlDe('passos', llengua)}#farmacia`, color:'turo', path:'<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6Z"/>' },
  { nom:es ? 'Policía Local' : 'Policia Local', url:'https://www.suria.cat/policialocal', color:'pedra', path:'<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/>' },
  { nom:es ? 'Sede electrónica' : 'Seu electrònica', url:'https://www.suria.cat/seuelectronica', color:'lavanda', path:'<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4m-4-10 3 3 5-6"/>' },
  ...(busUrl ? [{ nom: es ? 'Autobuses' : 'Autobusos', url:busUrl, color:'cel', path:'<rect x="5" y="3" width="14" height="15" rx="2"/><path d="M5 11h14M8 15h.01M16 15h.01M7 18v3m10-3v3"/>' }] : []),
];
---
<section class="serveis" aria-labelledby="h-serveis">
  <h2 id="h-serveis" class="titol-gran">{es ? 'Servicios útiles' : 'Serveis útils'}</h2>
  <ul>
    {serveis.map(s => <li data-facana={s.color}><a href={s.url}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={s.path}/><span>{s.nom}</span></a></li>)}
  </ul>
</section>
<style>
  [data-facana='rosa'] { --f-clar:#f1d3ca; --f:#eab7a9; --f-tinta:#754638; }
  [data-facana='llimona'] { --f-clar:#f3edbc; --f:#ded17d; --f-tinta:#62531b; }
  [data-facana='lavanda'] { --f-clar:#e4dfee; --f:#b9a9cc; --f-tinta:#59466e; }
  [data-facana='pedra'] { --f-clar:var(--pedra); --f:#d6cfc3; --f-tinta:var(--tinta-2); }
  h2 { font-size: clamp(1.75rem, 2.6vw, 2.375rem); margin-bottom: var(--s-4); }
  ul { display: grid; grid-auto-flow: column; grid-auto-columns: clamp(13rem, 20vw, 17rem); gap: var(--s-4); list-style:none; overflow-x:auto; scrollbar-width:none; padding: 6px; scroll-snap-type: x proximity; }
  ul::-webkit-scrollbar { display:none; }
  li { min-width:0; scroll-snap-align:start; }
  a { --radius:12px; --padding:max(16px, calc(var(--radius) * .75)); display:flex; flex-direction:column; align-items:flex-start; justify-content:space-between; gap:var(--s-4); aspect-ratio:1; min-height:13rem; padding:var(--padding); border-radius:var(--radius); background:var(--f-clar); color:var(--tinta); font:650 var(--t-small)/1.2 var(--display); text-decoration:none; }
  a:hover { text-decoration:underline; background:color-mix(in srgb, var(--f-clar), var(--f) 16%); }
  svg { width:2rem; height:2rem; flex:none; fill:none; stroke:var(--f-tinta); stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
</style>
