---
// Navegació persistent: les tasques, sempre visibles. Al mòbil, rejilla 2×2 (l'inici és la marca).
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe, type Pagina } from '../i18n/rutes.ts';

interface Props {
  llengua: Llengua;
  actual: Pagina | null;
}
const { llengua, actual } = Astro.props;
const t = traductor(llengua);
const items: { pagina: Pagina; clau: 'nav.inici' | 'nav.setmana' | 'nav.menjar' | 'nav.passos' | 'nav.cap' }[] = [
  { pagina: 'inici', clau: 'nav.inici' },
  { pagina: 'setmana', clau: 'nav.setmana' },
  { pagina: 'menjar', clau: 'nav.menjar' },
  { pagina: 'passos', clau: 'nav.passos' },
  { pagina: 'cap', clau: 'nav.cap' },
];
---
<nav class="tasques" aria-label={t('nav.etiqueta')}>
  <ul>
    {
      items.map(({ pagina, clau }) => (
        <li class:list={{ inici: pagina === 'inici' }}>
          <a href={urlDe(pagina, llengua)} aria-current={pagina === actual ? 'page' : undefined}>
            {t(clau)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tasques {
    border-bottom: var(--rule-thin);
  }
  @media (max-width: 56.25rem) {
    /* L'última fila no duplica la línia inferior de la navegació. */
    .tasques ul {
      margin-bottom: -1px;
    }
  }
  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-2);
    padding: 0 var(--pad);
  }
  a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding: 0 var(--s-3);
    font-family: var(--font-display-stack);
    font-weight: 700;
    font-size: var(--t-body);
    text-decoration: none;
  }
  li:first-child a {
    padding-left: 0;
  }
  a[aria-current] {
    box-shadow: inset 0 -4px var(--red);
    color: var(--red-ink);
  }
  a:hover {
    box-shadow: inset 0 -2px var(--marl);
  }
  a[aria-current]:hover {
    box-shadow: inset 0 -4px var(--red);
  }
  @media (max-width: 56.25rem) {
    /* Dues columnes a mida normal; una sola si el text s'amplia (la mida mínima va en rem). */
    ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
      gap: 0 var(--s-2);
    }
    li.inici {
      display: none;
    }
    a,
    li:first-child a {
      padding: 0 var(--s-1);
      min-height: var(--tap);
      font-size: var(--t-small);
    }
    li a {
      border-bottom: var(--rule-thin);
    }
  }
</style>
