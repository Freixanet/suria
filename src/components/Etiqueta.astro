---
// Maduresa (Real / En prova / Demo / Idea) tal com apareix a tot el lloc: text dins d'un marc.
// Idea i Demo, amb el marc discontinu de «el que encara no existeix». Mai només color.
import { traductor, type Llengua } from '../i18n/ui.ts';

interface Props {
  maduresa: 'Real' | 'En prova' | 'Demo' | 'Idea';
  llengua: Llengua;
  /** Text complet en lloc de la paraula sola. */
  text?: string;
}
const { maduresa, llengua, text } = Astro.props;
const t = traductor(llengua);
const especulativa = maduresa === 'Idea' || maduresa === 'Demo';
---
<span class:list={['maduresa', { especulativa }]}>{text ?? t(`maduresa.${maduresa}`)}</span>
