---
// Línia secundària d'una peça: font, vigència i responsable; la maduresa només si és Idea o Demo.
// La data de consulta es conserva a les dades però no es mostra (decisió del promotor, 14/10/2026).
import { traductor, type Llengua } from '../i18n/ui.ts';

interface Props {
  llengua: Llengua;
  maduresa: 'Real' | 'En prova' | 'Demo' | 'Idea';
  fonts: { nom: { ca: string; es: string } }[];
  consultat: string;
  responsable: string;
  vigencia?: string;
  mostraResponsable?: boolean;
}
const { llengua, maduresa, fonts, consultat, responsable, vigencia, mostraResponsable = true } = Astro.props;
const t = traductor(llengua);
const qui = responsable === 'Promotor del prototip' ? t('procedencia.promotor') : responsable;
---
<p class="procedencia">
  {(maduresa === 'Idea' || maduresa === 'Demo') && <span class="maduresa especulativa">{t(`maduresa.${maduresa}`)}</span>}
  <span>{t('procedencia.font')}: {fonts.map((f) => f.nom[llengua]).join('; ')}</span>
  {vigencia && <span>{t('procedencia.valid')}: {vigencia}</span>}
  {mostraResponsable && <span>{t('procedencia.responsable')}: {qui}</span>}
</p>

<style>
  .procedencia {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px dashed var(--filet);
    font-size: var(--t-meta);
    line-height: 1.45;
    color: var(--tinta-2);
  }
  .procedencia > span:not(.maduresa):not(:last-child)::after {
    content: ' ·';
  }
</style>
