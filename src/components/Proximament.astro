---
// Activitats que comencen després de la setmana declarada: separades, mai barrejades amb «Aquesta setmana».
// A la portada, compacte: títol, dates, el que cal fer aviat (punts marcats com a portada) i l'enllaç al detall.
import LiniaProcedencia from './LiniaProcedencia.astro';
import TextHores from './TextHores.astro';
import type { Activitat } from '../lib/dades.ts';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';
import { dataNumerica, diaMes } from '../lib/format.ts';

interface Props {
  llengua: Llengua;
  activitats: Activitat[];
  detall?: boolean;
  nivell?: 2 | 3;
  /** A la portada el títol de secció el posa CapcaleraSeccio (amb la maduresa). */
  ambTitol?: boolean;
}
const { llengua, activitats, detall = false, nivell = 3, ambTitol = true } = Astro.props;
const t = traductor(llengua);
const Titol = nivell === 2 ? 'h2' : 'h3';
const Peca = nivell === 2 ? 'h3' : 'h4';
const id = `proximament-${detall ? 'detall' : 'portada'}`;
---
{
  activitats.length > 0 && (
    <div class:list={['proximament', { compacte: !detall }]} id={detall ? 'proximament' : undefined}>
      {ambTitol && <Titol class="titol-gran obre-detall" id={id}>{t('setmana.proximament')}</Titol>}
      {activitats.map((a) => {
        const punts = detall ? a.punts : a.punts.filter((p) => p.portada);
        return (
          <article class="peca">
            <Peca class="titol-peca">
              {a.titol[llengua]}
              <span class="dates">
                <span class="visually-hidden">{' · '}</span>
                {a.dies.fi ? `${diaMes(a.dies.inici, llengua)} – ${diaMes(a.dies.fi, llengua)}` : diaMes(a.dies.inici, llengua)}
              </span>
            </Peca>
            {punts.length > 0 && (
              <ul>
                {punts.map((p) => (
                  <li>
                    {p.destacat && <strong>{p.destacat[llengua]}</strong>}
                    {p.destacat && ' '}
                    <TextHores text={p.text[llengua]} />
                  </li>
                ))}
              </ul>
            )}
            {detall ? (
              <a class="accio" href={a.enllac.url} hreflang="ca">{a.enllac.text[llengua]}</a>
            ) : (
              <a class="accio" href={`${urlDe('setmana', llengua)}#proximament`}>{t('setmana.proximamentDetall')}</a>
            )}
            {!detall && (
              <p class="font">
                <b>{t('procedencia.font')}:</b> {a.fonts.map((f) => f.nom[llengua]).join('; ')}, {t('procedencia.consultadaEl', { data: dataNumerica(a.consultat) })}.
              </p>
            )}
            {detall && (
              <LiniaProcedencia
                llengua={llengua}
                maduresa={a.maduresa ?? 'En prova'}
                fonts={a.fonts}
                consultat={a.consultat}
                responsable={a.responsable}
              />
            )}
          </article>
        );
      })}
    </div>
  )
}

<style>
  /* Pròximament: un cartell (programa de festa major) del color ocre de l'agenda. */
  .proximament {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
  }
  .obre-detall {
    font-size: var(--t-h2);
    margin-top: var(--s-7);
  }
  .peca {
    padding: var(--s-5) clamp(1rem, 3vw, 2rem) var(--s-4);
    background: var(--ocre);
    color: var(--tinta);
    border-radius: var(--radi);
  }
  .titol-peca {
    font-variation-settings: 'wdth' 85;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .compacte .titol-peca {
    font-size: clamp(1.625rem, 2.4vw, 2.125rem);
  }
  .dates {
    display: block;
    margin-top: var(--s-2);
    font-variation-settings: 'wdth' 100;
    font-size: var(--t-body);
    font-weight: 650;
    letter-spacing: 0;
  }
  ul {
    list-style: none;
    margin-top: var(--s-4);
    border-top: 1.5px solid var(--tinta);
  }
  li {
    padding-block: var(--s-2);
    border-bottom: 1px solid rgb(29 37 50 / 0.3);
  }
  strong {
    font-family: var(--display);
    font-weight: 700;
  }
  .accio:hover {
    color: var(--tinta);
  }
  .font {
    color: var(--tinta);
  }
  .peca :global(.procedencia) {
    color: var(--tinta);
    border-top-color: rgb(29 37 50 / 0.4);
  }
  .peca :global(.procedencia .maduresa) {
    border-color: var(--tinta);
  }
  .peca :global(:focus-visible) {
    outline-color: var(--tinta);
  }
</style>
