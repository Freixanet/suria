---
// Banda d'estrats sota la capçalera: la signatura del sistema i l'únic lloc on viuen els estrats.
// Il·lustració, no fotografia.
---
<div class="banda" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>

<style>
  .banda {
    display: grid;
    grid-template-rows: 8px 4px 9px 3px 6px;
    height: 30px;
  }
  i:nth-child(1) { background: var(--red); }
  i:nth-child(2) { background: var(--salmon); }
  i:nth-child(3) { background: var(--red-ink); }
  i:nth-child(4) { background: var(--halite); }
  i:nth-child(5) { background: var(--marl); }
  /* Al mòbil, més prima: les tasques no han de baixar. */
  @media (max-width: 56.25rem) {
    .banda {
      grid-template-rows: 6px 3px 7px 2px 4px;
      height: 22px;
    }
  }
</style>
