---
// Fotografia real de Súria amb autoria, llicència i enllaç a l'original sempre visibles.
import { Picture } from 'astro:assets';
import type { Foto } from '../lib/fotos.ts';
import type { Llengua } from '../i18n/ui.ts';

interface Props {
  foto: Foto;
  llengua: Llengua;
  /** Retall: 'escena' (portada, a tota amplada i neta), 'panoramica' o 'ampla' (pàgina de visió). */
  format?: 'escena' | 'panoramica' | 'ampla';
  sizes: string;
  /** La foto és l'element principal de la pàgina: es carrega de seguida i amb prioritat. */
  prioritaria?: boolean;
}
const { foto, llengua, format = 'panoramica', sizes, prioritaria = false } = Astro.props;
const credit = {
  ca: { foto: 'Foto', retall: 'retallada', original: 'original a Wikimedia Commons' },
  es: { foto: 'Foto', retall: 'recortada', original: 'original en Wikimedia Commons' },
}[llengua];
---
<figure class:list={['foto', format]}>
  <Picture
    src={foto.imatge}
    alt={foto.alt[llengua]}
    widths={[480, 800, 1200, 1600, 2000]}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    loading={prioritaria ? 'eager' : 'lazy'}
    fetchpriority={prioritaria ? 'high' : 'auto'}
    decoding="async"
  />
  <figcaption>
    <slot />
    <span class="credit"><span>{credit.foto}: {foto.autor}, {foto.data.slice(0, 4)}{foto.retallada && ` (${credit.retall})`}.</span>{' '}
    <span class="junts"><a href={foto.llicenciaUrl} rel="license">{foto.llicencia}</a> ·</span>{' '}<a href={foto.original} hreflang="en">{credit.original}</a></span>
    {/* Versió d'una línia (portada al mòbil): l'autor enllaça a l'original; es mantenen el retall i la llicència. */}
    <span class="credit-curt">{credit.foto}: <a href={foto.original} hreflang="en">{foto.autor}</a>{foto.retallada && `, ${credit.retall}`} · <a href={foto.llicenciaUrl} rel="license">{foto.llicencia}</a></span>
  </figcaption>
</figure>

<style>
  .foto :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--cel-fort);
    border-radius: var(--radi);
  }
  /* El retall manté el campanar i les cases dins del quadre (centre lleugerament a la dreta). */
  .panoramica :global(img) {
    aspect-ratio: 21 / 8;
    object-position: 62% 50%;
  }
  /* Portada: a tota amplada, amb aire sobre el campanar i el conjunt de les cases sencer. L'enquadrament
     es tria per separat a l'escriptori i al mòbil. */
  .escena :global(img) {
    height: clamp(20rem, 43vw, 41rem);
    object-position: 60% 22%;
    border-radius: 0;
  }
  @media (max-width: 56.25rem) {
    .escena :global(img) {
      height: auto;
      aspect-ratio: 3 / 2;
      object-position: 64% 50%;
    }
  }
  .ampla :global(img) {
    aspect-ratio: 16 / 9;
    object-position: 64% 50%;
  }
  figcaption {
    font-size: var(--t-tag);
    line-height: 1.45;
    color: var(--tinta-2);
    padding-top: var(--s-2);
  }
  .credit-curt {
    display: none;
  }
  /* La llicència i el seu separador no se separen: cap línia comença amb un punt solt. */
  .junts {
    white-space: nowrap;
  }
  /* Enllaços dins del peu: la zona tàctil arriba als 44 px sense canviar la mida del text. */
  figcaption a {
    display: inline-block;
    padding-block: 0.75rem;
  }
</style>
