---
// Idees de futur: una sola etiqueta explícita i filets discontinus. Mai barrejades amb dades reals.
import { traductor, type Llengua } from '../i18n/ui.ts';

interface Props {
  llengua: Llengua;
  idees: { text: { ca: string; es: string }; maduresa: 'Idea' | 'Demo' }[];
}
const { llengua, idees } = Astro.props;
const t = traductor(llengua);
const nomes = idees.filter((i) => i.maduresa === 'Idea');
---
<p class="etiqueta-idees" id="idees-pagina">{t('cap.idees')}</p>
<ul class="idees" aria-labelledby="idees-pagina">
  {nomes.map((i) => <li>{i.text[llengua]}</li>)}
</ul>

<style>
  /* Les idees: una sola etiqueta explícita i filets discontinus (el que encara no existeix). */
  .etiqueta-idees {
    margin-top: var(--s-6);
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--t-small);
    display: inline-block;
    padding: 0.05em 0.5em 0.1em;
    border: 1.5px dashed currentColor;
    border-radius: 0.3em;
  }
  .idees {
    list-style: none;
    margin-top: var(--s-3);
    border-top: 1px dashed var(--tinta-2);
  }
  li {
    padding: var(--s-3) 0;
    border-bottom: 1px dashed var(--tinta-2);
  }
</style>
