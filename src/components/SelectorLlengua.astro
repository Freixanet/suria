---
// Canvi de llengua: porta a la mateixa pàgina en l'altra llengua i recorda la tria al navegador.
import { llengues, traductor, type Llengua } from '../i18n/ui.ts';

interface Props {
  llengua: Llengua;
  urls: Record<Llengua, string>;
  /** A la franja fosca (mòbil i tauleta) o al costat de les tasques (escriptori). */
  lloc?: 'barra' | 'mast';
}
const { llengua, urls, lloc = 'barra' } = Astro.props;
const t = traductor(llengua);
---
<nav class:list={['llengua', lloc]} aria-label={t('llengua.etiqueta')}>
  <details data-selector-llengua>
    <summary aria-label={`${t('llengua.etiqueta')}: ${llengues[llengua]}`}>
      <span>{llengua.toUpperCase()}</span>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m4 6 4 4 4-4" /></svg>
    </summary>
    <div class="opcions">
      {(Object.keys(llengues) as Llengua[]).map((ll) => (
        <a href={urls[ll]} lang={ll} hreflang={ll} aria-current={ll === llengua ? 'true' : undefined} data-tria-llengua={ll}>{llengues[ll]}</a>
      ))}
    </div>
  </details>
</nav>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-selector-llengua]').forEach((selector) => {
    selector.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && selector.open) {
        event.stopPropagation();
        selector.open = false;
        selector.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !selector.contains(event.target)) selector.open = false;
    });
  });
  for (const enllac of document.querySelectorAll<HTMLAnchorElement>('[data-tria-llengua]')) {
    enllac.addEventListener('click', () => {
      try {
        localStorage.setItem('suria-llengua', enllac.dataset.triaLlengua ?? '');
      } catch {
        /* Sense emmagatzematge: el canvi funciona igual, només no es recorda. */
      }
    });
  }
</script>

<style>
  .llengua { position: relative; z-index: 20; display: inline-flex; }
  details { position: relative; }
  summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: var(--tap);
    padding-inline: var(--s-3);
    font: 700 1.125rem/1 var(--display);
    color: var(--tinta-2);
    cursor: pointer;
    list-style: none;
    border-radius: .3em;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--tinta); }
  svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .opcions {
    position: absolute;
    top: calc(100% + var(--s-1));
    right: 0;
    min-width: 10rem;
    padding: var(--s-2);
    border: 1px solid var(--filet);
    border-radius: var(--radi);
    background: var(--calc);
    color: var(--tinta);
    box-shadow: 0 8px 24px rgb(29 37 50 / .12);
  }
  a { display: flex; align-items: center; min-height: var(--tap); padding-inline: var(--s-3); border-radius: .3em; font: 600 1rem/1.3 var(--display); text-decoration: none; }
  a[aria-current] { color: var(--teula-tinta); font-weight: 800; }
  a:hover { background: var(--pedra); color: var(--tinta); }
  .barra summary { color: var(--calc); }
  @media (max-width: 79.999rem) { .opcions { left: 0; right: auto; } }
</style>
