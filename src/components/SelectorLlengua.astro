---
// Canvi de llengua: porta a la mateixa pàgina en l'altra llengua i recorda la tria al navegador.
import { llengues, traductor, type Llengua } from '../i18n/ui.ts';

interface Props {
  llengua: Llengua;
  urls: Record<Llengua, string>;
  /** A la franja fosca (mòbil i tauleta) o al costat de les tasques (escriptori). */
  lloc?: 'barra' | 'mast';
}
const { llengua, urls, lloc = 'barra' } = Astro.props;
const t = traductor(llengua);
---
<nav class:list={['llengua', lloc]} aria-label={t('llengua.etiqueta')}>
  {
    (Object.keys(llengues) as Llengua[]).map((ll) => (
      <a
        href={urls[ll]}
        lang={ll}
        hreflang={ll}
        aria-current={ll === llengua ? 'true' : undefined}
        data-tria-llengua={ll}
      >
        <span aria-hidden="true">{ll.toUpperCase()}</span>
        <span class="visually-hidden">{llengues[ll]}</span>
      </a>
    ))
  }
</nav>

<script>
  for (const enllac of document.querySelectorAll<HTMLAnchorElement>('[data-tria-llengua]')) {
    enllac.addEventListener('click', () => {
      try {
        localStorage.setItem('suria-llengua', enllac.dataset.triaLlengua ?? '');
      } catch {
        /* Sense emmagatzematge: el canvi funciona igual, només no es recorda. */
      }
    });
  }
</script>

<style>
  /* Només text, en majúscules espaiades: l'actual en color i negreta, amb el mateix subratllat que la tasca
     actual; les altres, en gris. La zona tàctil és de 44 px. */
  .llengua {
    display: flex;
    gap: var(--s-1);
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 0.3em;
  }
  a[aria-current] {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.35em;
  }
  a:not([aria-current]):hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  /* Franja fosca. */
  .barra a {
    color: rgb(253 252 250 / 0.78);
  }
  .barra a:hover,
  .barra a[aria-current] {
    color: var(--ocre);
  }
  /* Al costat de les tasques, sobre fons clar. */
  .mast a {
    font-size: 1.125rem;
    color: var(--tinta-2);
  }
  .mast a:hover {
    color: var(--tinta);
  }
  .mast a[aria-current] {
    color: var(--teula-tinta);
    text-decoration-color: var(--teula);
  }
</style>
