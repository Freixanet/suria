---
// Buit honest: diu què no sabem, sense omplir-lo amb res inventat (especificació UX 4.4).
interface Props {
  titol: string;
}
const { titol } = Astro.props;
---
<div class="buit">
  <p class="buit-titol">{titol}</p>
  <slot />
</div>

<style>
  .buit {
    background: var(--halite);
    border: var(--rule-thin);
    border-top: var(--rule-strong);
    padding: var(--s-3) var(--s-4) var(--s-4);
  }
  .buit-titol {
    font-family: var(--font-display-stack);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: var(--s-2);
  }
  .buit :global(p + p) {
    margin-top: var(--s-2);
  }
</style>
