---
// Buit honest: diu què no sabem, sense omplir-lo amb res inventat (especificació UX 4.4).
interface Props {
  titol: string;
}
const { titol } = Astro.props;
---
<div class="buit">
  <p class="buit-titol">{titol}</p>
  <slot />
</div>

<style>
  /* Sense caixa: com la resta de llistes, s'obre amb el filet de 2 px (el panell clar és només per a l'agenda). */
  .buit {
    border-top: var(--rule-strong);
    padding: var(--s-3) 0 var(--s-2);
    max-width: 44rem;
  }
  .buit-titol {
    font-family: var(--font-display-stack);
    font-weight: 800;
    font-size: var(--t-h3);
    line-height: 1.3;
    margin-bottom: var(--s-2);
  }
  .buit :global(p + p) {
    margin-top: var(--s-2);
  }
</style>
