---
// Buit honest: diu què no sabem, sense omplir-lo amb res inventat (especificació UX 4.4).
interface Props {
  titol: string;
}
const { titol } = Astro.props;
---
<div class="buit">
  <p class="buit-titol">{titol}</p>
  <slot />
</div>

<style>
  /* Buit honest (Lentos: «No dates found.»): una frase gran i clara, sense caixa. */
  .buit {
    padding-top: var(--s-4);
    max-width: 40rem;
  }
  .buit-titol {
    font-family: var(--display);
    font-weight: 650;
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: var(--s-3);
  }
  .buit :global(p + p) {
    margin-top: var(--s-2);
  }
</style>
