---
// Una activitat de l'agenda, sempre en el mateix ordre: dia (a la finestra), nom, hora, lloc, requisit essencial i acció.
// A la pàgina de detall, a més, l'explicació llarga i la línia de procedència.
import LiniaProcedencia from './LiniaProcedencia.astro';
import TextHores from './TextHores.astro';
import type { Activitat } from '../lib/dades.ts';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { franja, rangCurt } from '../lib/format.ts';
import { instantMadrid, sumaDies } from '../lib/hora-local.ts';

interface Props {
  activitat: Activitat;
  llengua: Llengua;
  /** A la pàgina de tasca: explicació llarga i línia de procedència. */
  detall?: boolean;
  maduresaSeccio: 'Real' | 'En prova';
  /** Nivell del títol de la peça: 3 a la portada (sota un h2), 2 a la pàgina de tasca (sota l'h1). */
  nivell?: 2 | 3;
}
const { activitat: a, llengua, detall = false, maduresaSeccio, nivell = 3 } = Astro.props;
const Titol = nivell === 2 ? 'h2' : 'h3';
const t = traductor(llengua);
const ultimDia = a.dies.fi ?? a.dies.inici;
const caduca = instantMadrid(sumaDies(ultimDia, 1), '00:00').toISOString();
const hores = a.hores.map((h) => franja(h.inici, h.fi, llengua)).join(', ');
---
<li class="activitat" data-caduca={caduca}>
  <time class="dia" datetime={a.dies.inici}>{rangCurt(a.dies.inici, a.dies.fi, llengua)}</time>
  <div class="cos">
    <Titol class="titol-peca">{a.titol[llengua]}</Titol>
    {hores && <p class="quan"><span class="hores">{hores}</span></p>}
    {a.lloc && <p class="lloc">{a.lloc[llengua]}</p>}
    {a.requisit && <p class="requisit"><TextHores text={a.requisit[llengua]} /></p>}
    {detall && a.nota && <p class="nota"><TextHores text={a.nota[llengua]} /></p>}
    <p class="passat" data-avis-caducat hidden>{t('setmana.passada')}</p>
    <a class="accio" href={a.enllac.url} hreflang="ca">
      {a.enllac.text[llengua]}<span class="visually-hidden">: {a.titol[llengua]}</span>
    </a>
    {
      detall && (
        <LiniaProcedencia
          llengua={llengua}
          maduresa={a.maduresa ?? maduresaSeccio}
          fonts={a.fonts}
          consultat={a.consultat}
          responsable={a.responsable}
        />
      )
    }
  </div>
</li>

<style>
  /* Fila de l'agenda (Lentos): la data en una «finestra» del color de la façana, i al costat què, quan i on. */
  /* Més espai entre entrades que entre les dades d'una mateixa entrada. */
  .activitat {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--s-1) var(--s-5);
    padding-block: var(--s-5) var(--s-6);
    border-bottom: var(--filet-fi);
  }
  .activitat:first-child {
    padding-top: var(--s-2);
  }
  .dia {
    align-self: start;
    display: block;
    padding: var(--s-2) var(--s-3) var(--s-3);
    background: var(--f-clar);
    border-top: 4px solid var(--f);
    border-radius: 0 0 0.4rem 0.4rem;
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .cos {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    max-width: 44rem;
  }
  .titol-peca {
    font-size: var(--t-h3);
    font-weight: 650;
    line-height: 1.2;
    margin-bottom: var(--s-1);
  }
  /* Hora: pes mitjà i xifres alineades; lloc: lletra de lectura. Cap renglera sencera en negreta. */
  .quan {
    font-family: var(--display);
    font-weight: 550;
    font-size: var(--t-small);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .lloc {
    font-size: var(--t-small);
  }
  .requisit {
    margin-top: var(--s-1);
    padding-left: var(--s-3);
    border-left: 2px solid var(--f);
    font-size: var(--t-small);
  }
  .nota {
    color: var(--tinta-2);
  }
  .passat {
    font-family: var(--display);
    font-weight: 650;
    font-size: var(--t-tag);
    color: var(--tinta-2);
  }
  .activitat[data-caducat] .dia {
    background: var(--pedra);
    border-top-color: var(--filet);
    color: var(--tinta-2);
  }
  .activitat[data-caducat] .titol-peca {
    color: var(--tinta-2);
  }
  @media (max-width: 30rem) {
    .activitat {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
      padding-block: var(--s-4);
    }
    .dia {
      justify-self: start;
      padding: var(--s-1) var(--s-3);
      border-top-width: 3px;
      font-size: 1.125rem;
    }
  }
</style>
