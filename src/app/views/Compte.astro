---
import AppLayout from '../AppLayout.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { comu, href, type Lang } from '../i18n.ts';
import { activitatsOrdenades, dataDe, franjaH, quan } from '../dades.ts';
import { comercos, entitats } from '../demo.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ca = lang === 'ca';
const t = comu[lang];
const acts = activitatsOrdenades();
const interessos = ca
  ? ['Cultura', 'Gent gran', 'Famílies', 'Esport i natura', 'Voluntariat', 'Comerç local', 'Patrimoni']
  : ['Cultura', 'Personas mayores', 'Familias', 'Deporte y naturaleza', 'Voluntariado', 'Comercio local', 'Patrimonio'];
const perfils = [
  { v: 'veinat', icona: 'home2', t: ca ? 'Hi visc de fa temps' : 'Vivo aquí desde hace tiempo', s: ca ? 'Vull estar al dia i participar' : 'Quiero estar al día y participar' },
  { v: 'nouvingut', icona: 'wave', t: ca ? 'Acabo d’arribar' : 'Acabo de llegar', s: ca ? 'Fa menys de dos anys que hi visc' : 'Hace menos de dos años que vivo aquí' },
  { v: 'negoci', icona: 'shop', t: ca ? 'Tinc un negoci' : 'Tengo un negocio', s: ca ? 'Vull que em trobin' : 'Quiero que me encuentren' },
  { v: 'visita', icona: 'compass', t: ca ? 'Estic de visita' : 'Estoy de visita', s: ca ? 'Vull conèixer el poble amb calma' : 'Quiero conocer el pueblo con calma' },
] as const;
const desats = [
  ...acts.map((a) => ({ id: `a:${a.id}`, titol: a.titol[lang], sub: quan(dataDe(a), lang), url: href(lang, 'agenda', a.id), icona: 'calendar' as const })),
  ...comercos.map((c) => ({ id: `c:${c.id}`, titol: c.nom, sub: c.zona[lang], url: href(lang, 'comerc', c.id), icona: 'shop' as const })),
  ...entitats.map((e) => ({ id: `g:${e.id}`, titol: e.nom[lang], sub: ca ? 'Grup que segueixes' : 'Grupo que sigues', url: href(lang, 'comunitat') + '#grups', icona: 'people' as const })),
];
---
<AppLayout lang={lang} ruta="compte" titol={t.nav.compte}>
  <div class="wrap" data-compte data-benvinguda={href(lang, 'benvinguda')}>

    <!-- 1. Correu -->
    <section class="auth" data-pas="correu">
      <Logo class="auth__mark" />
      <div>
        <h1 class="h-page" style="font-size:var(--fs-2xl)">{ca ? 'Entra a Súria' : 'Entra en Súria'}</h1>
        <p class="muted" style="margin-top:.5rem">{ca ? 'Sense contrasenyes: t’enviem un codi al correu. Llegir-ho tot és lliure; el compte és per participar.' : 'Sin contraseñas: te enviamos un código al correo. Leerlo todo es libre; la cuenta es para participar.'}</p>
      </div>
      <form class="stack" style="--s:.875rem" data-form="correu" novalidate>
        <div class="field">
          <label for="correu">{ca ? 'Correu electrònic' : 'Correo electrónico'}</label>
          <input id="correu" class="input" type="email" inputmode="email" autocomplete="email" placeholder="nom@correu.cat" required aria-describedby="correu-err" />
          <p class="err" id="correu-err" data-err hidden>{ca ? 'Revisa el correu: sembla que hi falta alguna cosa.' : 'Revisa el correo: parece que falta algo.'}</p>
        </div>
        <button class="btn btn--l btn--block" type="submit">{ca ? 'Envia’m el codi' : 'Envíame el código'}</button>
      </form>
      <p class="divider">{ca ? 'o' : 'o'}</p>
      <div class="stack" style="--s:.5rem">
        <button class="btn btn--ghost btn--block" data-social="apple"><svg class="i-s" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.7c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.8-1.1-2.9-4.1ZM13.9 5.2c.7-.9 1.2-2 1-3.2-1 .1-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.1 1.1.1 2.3-.6 3.1-1.5Z"/></svg>{ca ? 'Continua amb Apple' : 'Continúa con Apple'}</button>
        <button class="btn btn--ghost btn--block" data-social="google"><svg class="i-s" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3Z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14Z"/><path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 6 12 6Z"/></svg>{ca ? 'Continua amb Google' : 'Continúa con Google'}</button>
      </div>
      <p class="hint" style="display:flex;gap:.375rem;align-items:start;justify-content:center"><Icon name="lock" class="i-s" /> {ca ? 'Prototip: no s’envia cap correu ni surt cap dada del teu dispositiu.' : 'Prototipo: no se envía ningún correo ni sale ningún dato de tu dispositivo.'}</p>
    </section>

    <!-- 2. Codi -->
    <section class="auth" data-pas="codi" hidden>
      <button class="iconbtn" data-torna="correu" aria-label={ca ? 'Enrere' : 'Atrás'} style="margin-left:-.5rem"><Icon name="back" /></button>
      <div>
        <h1 class="h-page" style="font-size:var(--fs-2xl)">{ca ? 'Mira el correu' : 'Mira el correo'}</h1>
        <p class="muted" style="margin-top:.5rem">{ca ? 'Hem enviat un codi de 6 xifres a ' : 'Hemos enviado un código de 6 cifras a '}<strong data-correu></strong>.</p>
      </div>
      <form class="stack" style="--s:1rem" data-form="codi">
        <fieldset >
          <legend class="sr">{ca ? 'Codi de verificació' : 'Código de verificación'}</legend>
          <div class="otp" data-otp>
            {[1, 2, 3, 4, 5, 6].map((n) => <input inputmode="numeric" maxlength="1" autocomplete={n === 1 ? 'one-time-code' : 'off'} aria-label={`${ca ? 'Xifra' : 'Cifra'} ${n}`} />)}
          </div>
        </fieldset>
        <p class="hint">{ca ? 'Demostració: qualsevol codi de 6 xifres funciona.' : 'Demostración: cualquier código de 6 cifras funciona.'}</p>
        <button class="btn btn--l btn--block" type="submit" disabled>{ca ? 'Continua' : 'Continúa'}</button>
        <button type="button" class="btn btn--ghost btn--block" data-reenvia>{ca ? 'Torna a enviar el codi' : 'Vuelve a enviar el código'}</button>
      </form>
    </section>

    <!-- 3. Perfil -->
    <section class="auth" data-pas="perfil" hidden>
      <div>
        <p class="kicker">{ca ? 'Últim pas' : 'Último paso'}</p>
        <h1 class="h-page" style="font-size:var(--fs-2xl);margin-top:.375rem">{ca ? 'Com et diuen els veïns?' : '¿Cómo te llaman los vecinos?'}</h1>
      </div>
      <form class="stack" style="--s:1.5rem" data-form="perfil" novalidate>
        <div class="field">
          <label for="nom">{ca ? 'Nom i cognom' : 'Nombre y apellido'}</label>
          <input id="nom" name="nom" class="input" autocomplete="name" placeholder={ca ? 'Per exemple, Marta Puig' : 'Por ejemplo, Marta Puig'} />
          <p class="hint">{ca ? 'A la comunitat es mostra el nom i la inicial del cognom.' : 'En la comunidad se muestra el nombre y la inicial del apellido.'}</p>
          <p class="err" data-err hidden>{ca ? 'Escriu el teu nom, si us plau.' : 'Escribe tu nombre, por favor.'}</p>
        </div>
        <fieldset >
          <legend class="label" style="font:650 var(--fs-s) var(--display);margin-bottom:.5rem">{ca ? 'Què et descriu millor?' : '¿Qué te describe mejor?'}</legend>
          <div class="choice">
            {perfils.map((p, i) => (
              <label><input type="radio" name="perfil" value={p.v} checked={i === 0} /><span class="row__ico" data-f={['ocre', 'cel', 'teula', 'turo'][i]}><Icon name={p.icona} /></span><span><strong>{p.t}</strong><small>{p.s}</small></span></label>
            ))}
          </div>
        </fieldset>
        <fieldset >
          <legend class="label" style="font:650 var(--fs-s) var(--display);margin-bottom:.5rem">{ca ? 'Què t’interessa? (opcional)' : '¿Qué te interesa? (opcional)'}</legend>
          <div class="interest">{interessos.map((x) => <label><input type="checkbox" name="interes" value={x} /><span>{x}</span></label>)}</div>
        </fieldset>
        <fieldset >
          <legend class="label" style="font:650 var(--fs-s) var(--display);margin-bottom:.5rem">{ca ? 'Mida del text' : 'Tamaño del texto'}</legend>
          <div class="textsize">
            <label style="font-size:1rem"><input type="radio" name="text" value="m" checked />A</label>
            <label style="font-size:1.25rem"><input type="radio" name="text" value="l" />A</label>
            <label style="font-size:1.5rem"><input type="radio" name="text" value="xl" />A</label>
          </div>
        </fieldset>
        <button class="btn btn--l btn--block" type="submit">{ca ? 'Comença' : 'Empieza'}</button>
        <p class="hint">{ca ? 'En crear el compte acceptes les normes de convivència. Pots esborrar-lo quan vulguis.' : 'Al crear la cuenta aceptas las normas de convivencia. Puedes borrarla cuando quieras.'}</p>
      </form>
    </section>

    <!-- Tauler -->
    <section data-pas="tauler" hidden style="max-width:48rem;margin-inline:auto;padding-bottom:2rem">
      <div class="profile">
        <span class="avatar avatar--l" data-u="avatar"></span>
        <div>
          <h1 data-u="nom"></h1>
          <p class="muted"><span data-u="perfil"></span> · <span data-u="correu"></span></p>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><b data-stat="apuntat">0</b><span>{ca ? 'activitats' : 'actividades'}</span></div>
        <div class="stat"><b data-stat="gracies">0</b><span>{ca ? 'gràcies donades' : 'gracias dadas'}</span></div>
        <div class="stat"><b data-stat="posts">0</b><span>{ca ? 'publicacions' : 'publicaciones'}</span></div>
      </div>

      <section class="section" aria-labelledby="meves">
        <h2 class="h-sec" id="meves" style="margin-bottom:.5rem">{ca ? 'On aniràs' : 'Dónde irás'}</h2>
        <div class="rows card">
          {acts.map((a) => (
            <a class="row" href={href(lang, 'agenda', a.id)} data-meva={a.id} hidden data-f="ocre"><span class="row__ico"><Icon name="calendar" /></span><span class="row__body"><span class="row__title">{a.titol[lang]}</span><span class="row__sub">{quan(dataDe(a), lang)} · {franjaH(a, lang)}</span></span><Icon name="chevron" class="i-s row__end" /></a>
          ))}
          <p class="muted" data-meves-buit>{ca ? 'Encara no t’has apuntat a res. ' : 'Todavía no te has apuntado a nada. '}<a href={href(lang, 'agenda')}>{ca ? 'Mira l’agenda' : 'Mira la agenda'}</a></p>
        </div>
      </section>

      <section class="section" aria-labelledby="desats-t">
        <h2 class="h-sec" id="desats-t" style="margin-bottom:.5rem">{ca ? 'Desats i seguits' : 'Guardados y seguidos'}</h2>
        <div class="rows card">
          {desats.map((d) => (
            <a class="row" href={d.url} data-desat-item={d.id} hidden data-f="pissarra"><span class="row__ico"><Icon name={d.icona} /></span><span class="row__body"><span class="row__title">{d.titol}</span><span class="row__sub">{d.sub}</span></span><Icon name="chevron" class="i-s row__end" /></a>
          ))}
          <p class="muted" data-desats-buit>{ca ? 'Desa activitats, comerços i grups per trobar-los aquí.' : 'Guarda actividades, comercios y grupos para encontrarlos aquí.'}</p>
        </div>
      </section>

      <section class="section" aria-labelledby="lectura">
        <h2 class="h-sec" id="lectura" style="margin-bottom:.25rem">{ca ? 'Lectura i aparença' : 'Lectura y apariencia'}</h2>
        <div class="card" style="padding-block:.25rem">
          <div class="setting setting--stack">
            <span class="setting__l"><strong>{ca ? 'Mida del text' : 'Tamaño del texto'}</strong><small>{ca ? 'S’aplica a tota l’app' : 'Se aplica a toda la app'}</small></span>
            <div class="seg" role="group" aria-label={ca ? 'Mida del text' : 'Tamaño del texto'}>
              <button data-set-text="m" aria-pressed="false">{ca ? 'Normal' : 'Normal'}</button>
              <button data-set-text="l" aria-pressed="false">{ca ? 'Gran' : 'Grande'}</button>
              <button data-set-text="xl" aria-pressed="false">{ca ? 'Molt gran' : 'Muy grande'}</button>
            </div>
          </div>
          <div class="setting setting--stack">
            <span class="setting__l"><strong>{ca ? 'Tema' : 'Tema'}</strong><small>{ca ? 'Fosc per a la nit' : 'Oscuro para la noche'}</small></span>
            <div class="seg" role="group" aria-label={ca ? 'Tema' : 'Tema'}>
              <button data-set-theme="system" aria-pressed="false">{ca ? 'Automàtic' : 'Automático'}</button>
              <button data-set-theme="light" aria-pressed="false">{ca ? 'Clar' : 'Claro'}</button>
              <button data-set-theme="dark" aria-pressed="false">{ca ? 'Fosc' : 'Oscuro'}</button>
            </div>
          </div>
          <div class="setting">
            <span class="setting__l"><strong>{t.llengua}</strong><small>{ca ? 'Català' : 'Castellano'}</small></span>
            <a class="btn btn--s btn--ghost" href={href(ca ? 'es' : 'ca', 'compte')} data-astro-reload>{t.altraLlengua}</a>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="avisos-t">
        <h2 class="h-sec" id="avisos-t" style="margin-bottom:.25rem">{ca ? 'Avisos' : 'Avisos'}</h2>
        <div class="card" style="padding-block:.25rem">
          {[
            { k: 'agenda', t: ca ? 'Recordatoris d’activitats' : 'Recordatorios de actividades', s: ca ? 'El dia abans, a les 18 h' : 'El día antes, a las 18 h' },
            { k: 'avisos', t: ca ? 'Avisos importants del poble' : 'Avisos importantes del pueblo', s: ca ? 'Talls, obres, emergències' : 'Cortes, obras, emergencias' },
            { k: 'comunitat', t: ca ? 'Respostes a les meves publicacions' : 'Respuestas a mis publicaciones', s: ca ? 'Com a màxim, un resum al dia' : 'Como máximo, un resumen al día' },
            { k: 'comerc', t: ca ? 'Ofertes dels comerços que segueixo' : 'Ofertas de los comercios que sigo', s: ca ? 'Una vegada per setmana' : 'Una vez por semana' },
          ].map((n) => (
            <label class="setting" for={`n-${n.k}`}>
              <span class="setting__l"><strong>{n.t}</strong><small>{n.s}</small></span>
              <span class="switch"><input type="checkbox" id={`n-${n.k}`} data-notif={n.k} /><span></span></span>
            </label>
          ))}
        </div>
      </section>

      <section class="section" aria-labelledby="privacitat">
        <h2 class="h-sec" id="privacitat" style="margin-bottom:.25rem">{ca ? 'Les teves dades' : 'Tus datos'}</h2>
        <div class="card stack" style="--s:.625rem">
          <p class="muted small">{ca ? 'No venem dades ni hi ha anuncis que et segueixin. En aquest prototip, tot es queda al teu dispositiu.' : 'No vendemos datos ni hay anuncios que te sigan. En este prototipo, todo se queda en tu dispositivo.'}</p>
          <button class="btn btn--soft btn--block" data-exporta><Icon name="share" class="i-s" />{ca ? 'Descarrega les meves dades' : 'Descarga mis datos'}</button>
          <button class="btn btn--ghost btn--block" data-surt><Icon name="logout" class="i-s" />{ca ? 'Surt del compte' : 'Sal de la cuenta'}</button>
          <button class="btn btn--ghost btn--block" data-esborra style="color:var(--avis)"><span data-lbl>{ca ? 'Esborra el compte' : 'Borra la cuenta'}</span></button>
        </div>
      </section>
    </section>
  </div>
</AppLayout>
