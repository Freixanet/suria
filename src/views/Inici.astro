---
// Portada «Façanes», tercera passada. La capçalera porta la marca i les tasques sobre fons clar i, a sota,
// la foto del poble a tota amplada, neta.
// Després, «Avui a Súria» (Belle Isle) sobre el fons clar: títol fix, salutació i data en segon pla, i dos fets
// per llegir d'un cop d'ull, l'agenda (d'avui o la pròxima, amb data) i la farmàcia de guàrdia.
// Després, el que és útil (Lentos): l'agenda amb el cartell de pròximament a sota i, al costat, primers passos
// i comerços (compacte si encara no n'hi ha). Al final, «Cap on anem» en el verd del turó.
// Mòbil: marca i tasques, foto, avui, agenda, primers passos, pròximament, comerços.
import Base from '../layouts/Base.astro';
import CapcaleraSeccio from '../components/CapcaleraSeccio.astro';
import Agenda from '../components/Agenda.astro';
import Proximament from '../components/Proximament.astro';
import ComercosAvui from '../components/ComercosAvui.astro';
import PrimersPassos from '../components/PrimersPassos.astro';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';
import { agenda, comercos, consultaMesRecent, idees, passos } from '../lib/dades.ts';
import { dataNumerica } from '../lib/format.ts';
import type { DadesAra } from '../lib/ara.ts';

interface Props {
  llengua: Llengua;
}
const { llengua } = Astro.props;
const t = traductor(llengua);
const { setmana, aquestaSetmana, proximament } = await agenda();
const llistaPassos = await passos();
const llistaComercos = await comercos();
const llistaIdees = await idees();
const consultaAgenda = dataNumerica(consultaMesRecent(aquestaSetmana));
const consultaPassos = dataNumerica(consultaMesRecent(llistaPassos));
const senseComercos = llistaComercos.length === 0;

const farmacia = llistaPassos.find((p) => p.guardies.length > 0);
const consultaAvui = dataNumerica(consultaMesRecent([...aquestaSetmana, ...(farmacia ? [farmacia] : [])]));
const dadesAra: DadesAra = {
  setmana,
  activitats: [
    ...aquestaSetmana.map((a) => ({ titol: a.titol[llengua], inici: a.dies.inici, fi: a.dies.fi, hores: a.hores, lloc: a.lloc?.[llengua], ancora: '#h-setmana' })),
    ...proximament.map((a) => ({ titol: a.titol[llengua], inici: a.dies.inici, fi: a.dies.fi, hores: a.hores, lloc: a.lloc?.[llengua], ancora: '#h-proximament' })),
  ],
  guardies: farmacia?.guardies.map((g) => ({ farmacia: g.farmacia, adreca: g.adreca, telefon: g.telefon, desDe: g.desDe, finsA: g.finsA })) ?? [],
};
const textosAra = {
  senseVigent: t('passos.guardia.senseVigent'),
  fontOficial: t('passos.guardia.fontOficial'),
  fontUrl: farmacia?.fonts[0]?.url ?? 'https://www.suria.cat/',
  agendaOficial: t('setmana.agendaMunicipal'),
};
---
<Base llengua={llengua} pagina="inici">
  <section class="ample avui" aria-labelledby="h-avui" data-avui-resum={JSON.stringify(dadesAra)} data-textos={JSON.stringify(textosAra)} data-llengua={llengua}>
    <div class="avui-cap">
      <h2 id="h-avui" class="titol-gran">{t('ara.titol')}</h2>
      <p class="avui-salutacio" data-salutacio></p>
    </div>
    <div class="fet" data-facana="ocre" data-fet-agenda>
      <p class="fet-etiqueta">{t('nav.setmana')}</p>
      <a class="fet-titol" href="#h-setmana">{t('ara.senseJs.agenda', { n: String(aquestaSetmana.length) })}</a>
    </div>
    <div class="fet" data-facana="cel" data-fet-farmacia>
      <p class="fet-etiqueta">{farmacia?.titol[llengua]}</p>
      <a class="fet-titol" href={`${urlDe('passos', llengua)}#farmacia`}>{t('ara.senseJs.farmacia')}</a>
    </div>
    <p class="font avui-font"><b>{t('procedencia.font')}:</b> {t('ara.font', { data: consultaAvui })}</p>
  </section>

  <div class:list={['ample', 'util', { 'amb-comercos': !senseComercos }]}>
    <section class="setmana" data-facana="ocre" aria-labelledby="h-setmana">
      <CapcaleraSeccio id="h-setmana" titol={t('setmana.titol')} maduresa="En prova" llengua={llengua} />
      <Agenda llengua={llengua} setmana={setmana} activitats={aquestaSetmana} />
      <p class="font peu-seccio"><b>{t('procedencia.font')}:</b> {t('setmana.fontResum', { data: consultaAgenda })}</p>
      <a class="accio" href={urlDe('setmana', llengua)}>{t('tasca.veureSetmana')}</a>
    </section>

    <section class="passos" data-facana="cel" aria-labelledby="h-passos">
      <CapcaleraSeccio id="h-passos" titol={t('passos.titol')} maduresa="En prova" llengua={llengua} compacte />
      <PrimersPassos llengua={llengua} passos={llistaPassos} />
      <p class="font peu-seccio"><b>{t('procedencia.font')}:</b> {t('passos.fontResum', { data: consultaPassos })}</p>
      <a class="accio" href={urlDe('passos', llengua)}>{t('tasca.veurePassos')}</a>
    </section>

    {
      proximament.length > 0 && (
        <section class="proxim" data-facana="ocre" aria-labelledby="h-proximament">
          <CapcaleraSeccio id="h-proximament" titol={t('setmana.proximament')} maduresa="En prova" llengua={llengua} compacte />
          <Proximament llengua={llengua} activitats={proximament} ambTitol={false} nivell={2} />
        </section>
      )
    }

    <section class:list={['menjar', { buida: senseComercos }]} data-facana="teula" aria-labelledby="h-menjar">
      <CapcaleraSeccio id="h-menjar" titol={t('menjar.titol')} maduresa="En prova" llengua={llengua} compacte />
      <ComercosAvui llengua={llengua} comercos={llistaComercos} />
    </section>
  </div>

  <section class="cap" data-facana="turo" aria-labelledby="h-cap">
    <div class="ample cap-dins">
      <div>
        <h2 id="h-cap" class="titol-gran">{t('cap.titol')}</h2>
        <p class="identitat">{t('identitat.text')}</p>
        <p class="font-identitat">{t('identitat.font')}</p>
        <p class="cap-intro">{t('cap.intro')}</p>
        <a class="accio" href={urlDe('cap', llengua)}>{t('nav.cap')}</a>
      </div>
      <div>
        <p class="idea" id="idees-etiqueta">{t('cap.idees')}</p>
        <ul class="idees" aria-labelledby="idees-etiqueta">
          {llistaIdees.map((i) => <li>{i.text[llengua]}</li>)}
        </ul>
        <p class="provant">{t('provant.descripcio')} <a class="accio" href={urlDe('provant', llengua)}>{t('nav.provant')}</a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/ara.ts';
</script>

<style>
  /* «Avui a Súria»: sobre el fons clar del contingut, amb la mateixa reixa que l'agenda i els primers passos.
     El color, només als filets d'accent de cada fet. */
  .avui {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    column-gap: clamp(1.5rem, 5vw, 5rem);
    row-gap: var(--s-4);
    padding-top: var(--s-5);
    align-items: start;
  }
  .avui-cap {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1) var(--s-4);
  }
  .avui-cap h2 {
    font-size: var(--t-h2);
  }
  .avui-salutacio {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.0625rem, 1.5vw, 1.375rem);
    color: var(--tinta-2);
  }
  .avui-salutacio:empty {
    display: none;
  }
  /* Un fet: filet d'accent de la seva façana, etiqueta, el què en gran i el quan i on a sota. L'agenda mana;
     la farmàcia, un graó per sota. L'alçada mínima reserva el lloc del resum calculat (la pàgina no salta). */
  .fet {
    min-height: 9.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding-top: var(--s-2);
    border-top: 4px solid var(--f);
  }
  .fet :global(.fet-etiqueta) {
    font-family: var(--display);
    font-weight: 650;
    font-size: var(--t-tag);
    color: var(--tinta-2);
  }
  .fet :global(.fet-nota) {
    font-size: var(--t-meta);
    color: var(--tinta-2);
  }
  .fet :global(.fet-titol),
  .fet :global(.fet-avis) {
    font-family: var(--display);
    font-weight: 650;
    font-size: clamp(1.3125rem, 1.9vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .fet :global(a.fet-titol) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.16em;
    text-decoration-color: rgb(29 37 50 / 0.35);
  }
  .fet :global(a.fet-titol:hover) {
    color: var(--tinta);
    text-decoration-color: currentColor;
  }
  .fet :global(.fet-quan) {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--t-small);
    margin-top: var(--s-1);
  }
  .fet :global(.fet-lloc) {
    font-size: var(--t-small);
  }
  .fet[data-facana='ocre'] :global(.fet-titol),
  .fet[data-facana='ocre'] :global(.fet-avis) {
    font-size: clamp(1.5rem, 2.4vw, 2.125rem);
  }
  .fet[data-facana='cel'] {
    border-top-color: var(--cel-tinta);
  }
  .avui-font {
    grid-column: 1 / -1;
  }

  /* Útil (Lentos): agenda i, a sota, el cartell de pròximament; al costat, primers passos i comerços. */
  .util {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(1.5rem, 5vw, 5rem);
    row-gap: var(--s-7);
    padding-top: clamp(2rem, 3.5vw, 3rem);
    align-items: start;
  }
  .setmana {
    grid-column: 1;
    grid-row: 1 / 3;
  }
  .passos {
    grid-column: 2;
    grid-row: 1;
  }
  .menjar {
    grid-column: 2;
    grid-row: 2 / 4;
  }
  .proxim {
    grid-column: 1;
    grid-row: 3;
  }
  /* Amb comerços participants, les fitxes ocupen tota l'amplada sota la resta. */
  .amb-comercos .menjar {
    grid-column: 1 / -1;
    grid-row: 4;
    padding-top: var(--s-5);
    border-top: 6px solid var(--teula);
  }
  .peu-seccio {
    margin-top: var(--s-4);
  }
  /* Sense comerços: una nota breu i honesta, no una secció sencera. */
  .buida {
    padding: var(--s-4) var(--s-4) var(--s-3);
    background: var(--teula-clar);
    border-radius: var(--radi);
  }
  .buida :global(.buit) {
    padding-top: 0;
  }
  .buida :global(.buit-titol) {
    font-size: var(--t-h3);
  }
  .buida :global(.buit p:not(.buit-titol)) {
    font-size: var(--t-small);
  }

  /* Cap on anem: la façana verda del turó. Les idees, amb filets discontinus i l'etiqueta explícita. */
  .cap {
    margin-top: var(--s-9);
    background: var(--turo);
    color: var(--sobre-turo);
  }
  .cap-dins {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-6) clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .cap h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--s-4);
  }
  .identitat {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.25;
    max-width: 22em;
  }
  .font-identitat {
    margin: var(--s-1) 0 var(--s-4);
    font-size: var(--t-meta);
    color: var(--sobre-turo-2);
  }
  .cap-intro {
    max-width: 30em;
    margin-bottom: var(--s-2);
  }
  .idea {
    display: inline-block;
    padding: 0.05em 0.5em 0.1em;
    border: 1.5px dashed currentColor;
    border-radius: 0.3em;
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--t-small);
  }
  .idees {
    list-style: none;
    margin: var(--s-3) 0 var(--s-5);
    border-top: 1px dashed var(--sobre-turo-2);
  }
  .idees li {
    padding: var(--s-2) 0;
    border-bottom: 1px dashed var(--sobre-turo-2);
    color: var(--sobre-turo-2);
  }
  .provant {
    color: var(--sobre-turo-2);
    max-width: 36em;
  }
  .provant .accio {
    color: var(--sobre-turo);
  }
  .cap .accio:hover {
    color: var(--ocre);
  }
  .cap :global(a:focus-visible) {
    outline-color: var(--ocre);
  }

  @media (max-width: 56.25rem) {
    .avui {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-3);
      padding-top: var(--s-3);
    }
    .avui-cap h2 {
      font-size: 1.875rem;
    }
    .fet {
      min-height: 9rem;
    }
    .util,
    .cap-dins {
      grid-template-columns: minmax(0, 1fr);
    }
    .util {
      grid-template-rows: none;
      row-gap: var(--s-7);
      padding-top: var(--s-4);
    }
    .setmana,
    .passos,
    .menjar,
    .proxim,
    .amb-comercos .menjar {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
