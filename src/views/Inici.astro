---
// Portada: composició Avui, agenda, informació pràctica i actualitat.
import InformacioPractica from '../components/InformacioPractica.astro';
import Actualitat from '../components/Actualitat.astro';
import Base from '../layouts/Base.astro';
import CapcaleraSeccio from '../components/CapcaleraSeccio.astro';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';
import { agenda, passos } from '../lib/dades.ts';
import type { DadesAra } from '../lib/ara.ts';

interface Props {
  llengua: Llengua;
}
const { llengua } = Astro.props;
const t = traductor(llengua);
const { setmana, aquestaSetmana, proximament } = await agenda();
const llistaPassos = await passos();
const farmacia = llistaPassos.find((p) => p.guardies.length > 0);
const dadesAra: DadesAra = {
  setmana,
  activitats: [
    ...aquestaSetmana.map((a) => ({ titol: a.titol[llengua], inici: a.dies.inici, fi: a.dies.fi, hores: a.hores, lloc: a.lloc?.[llengua], ancora: '#h-setmana', enllac: a.enllac.url, imatge: a.imatge && { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}${a.imatge.src}`, alt: a.imatge.alt[llengua], font: a.imatge.font } })),
    ...proximament.map((a) => ({ titol: a.titol[llengua], inici: a.dies.inici, fi: a.dies.fi, hores: a.hores, lloc: a.lloc?.[llengua], ancora: '#h-proximament', enllac: a.enllac.url, imatge: a.imatge && { src: `${import.meta.env.BASE_URL.replace(/\/$/, '')}${a.imatge.src}`, alt: a.imatge.alt[llengua], font: a.imatge.font } })),
  ],
  guardies: farmacia?.guardies.map((g) => ({ farmacia: g.farmacia, adreca: g.adreca, telefon: g.telefon, desDe: g.desDe, finsA: g.finsA })) ?? [],
};
const textosAra = {
  senseVigent: t('passos.guardia.senseVigent'),
  fontOficial: t('passos.guardia.fontOficial'),
  fontUrl: farmacia?.fonts[0]?.url ?? 'https://www.suria.cat/',
  agendaOficial: t('setmana.agendaMunicipal'),
  veureAgenda: t('ara.veureAgenda'),
  trucar: t('ara.trucar'),
  comArribar: t('ara.comArribar'),
  seguentTorn: t('ara.seguentTorn'),
};
---
<Base llengua={llengua} pagina="inici">
  <div class="ample composicio portada-grid">
  <section class="avui" id="h-avui" aria-label={t('ara.titol')}>
    <div class="avui-proves">
    <div class="avui-prova avui-prova-rectangular" data-facana="ocre" aria-hidden="true"></div>
    <div class="avui-prova" data-facana="turo" aria-hidden="true"></div>
    <div class="avui-prova" data-facana="cel" aria-hidden="true"></div>
    </div>
  </section>

  <div class="util">
    <section class="setmana" data-facana="ocre" aria-labelledby="h-setmana" data-agenda-mode="properes" data-agenda-url={urlDe('setmana', llengua)} data-avui-resum={JSON.stringify(dadesAra)} data-textos={JSON.stringify(textosAra)} data-llengua={llengua}>
      <CapcaleraSeccio id="h-setmana" titol={t('setmana.titol')} maduresa="En prova" llengua={llengua} />
      <div class="avui-agenda" data-agenda-targetes>
        <div class="fet" data-facana="ocre" data-fet-agenda>
        </div>
      </div>
    </section>

    <div class="serveis-util"><InformacioPractica llengua={llengua} /><Actualitat llengua={llengua} /></div>

  </div>

  </div>

</Base>

<script>
  import '../scripts/ara.ts';
</script>

<style>
  /* Reixa compartida de portada i panell solapat d’Avui. */
  .portada-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: min-content auto auto;
    gap: var(--espai-seccions) clamp(2rem, 4vw, 4rem);
    --radius: var(--solapa);
    --border-width: 0px;
    --padding: max(16px, calc(var(--radius) * 0.75));
    padding-top: 0;
  }
  /* Les dues seccions comparteixen la reixa sense duplicar contingut ni alterar el DOM. */
  .util { display: contents; }
  .avui {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    margin-top: -4rem;
    padding: 1.5rem;
    background: var(--calc);
    border-radius: 2rem 2rem 0 0;
  }
  .avui-proves {
    --avui-gap: 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
    gap: var(--avui-gap);
    width: 100%;
  }
  .avui-prova { aspect-ratio: 1; min-width: 0; border-radius: 24px; background: var(--f-clar); }
  .avui-prova-rectangular { aspect-ratio: 2; }
  @media (max-width: 40rem) {
    .avui { margin-top: -2rem; padding: 1rem; }
    .avui-proves { --avui-gap: .5rem; }
  }

  /* Les targetes de la prova setmanal només mostren la data. */
  .avui-agenda :global(.fet) {
    min-height: 22rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    padding: 18px;
    aspect-ratio: auto;
    border: 0;
    border-radius: 24px;
    background: var(--f-clar);
    min-width: 0;
    overflow: hidden;
    position: relative;
  }
  .avui-agenda :global(.fet-data) {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: var(--s-4);
    border: 0;
    border-radius: 12px;
    background: var(--calc);
    color: var(--f-tinta);
    font-family: var(--display);
    line-height: 1;
  }
  .avui-agenda :global(.fet-dia) { font-size: 1.75rem; font-weight: 700; }
  .avui-agenda :global(.fet-mes) { margin-top: .25rem; font-size: .75rem; font-weight: 600; text-transform: uppercase; }
  .avui-agenda {
    display: grid;
    grid-template-columns: repeat(var(--targetes-visibles, 1), minmax(0, 22rem));
    justify-content: start;
    gap: var(--s-5);
    padding-bottom: var(--s-2);
  }
  .avui-agenda :global(.fet[hidden]) { display: none; }
  .setmana { grid-column: 1; grid-row: 2; }
  .serveis-util > :global(*) { min-width: 0; }
  .serveis-util { display: grid; gap: var(--espai-seccions); grid-column: 1 / -1; grid-row: 3; min-width:0; }
  .avui-agenda { max-width: 100%; }
  @media (max-width: 40rem) {
    .avui-agenda { gap: var(--s-4); }
  }
  @media (max-width: 56.25rem) {
    .portada-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: var(--espai-seccions);
      padding-top: 0;
    }
    .setmana, .serveis-util { grid-column: 1; grid-row: auto; }
  }
</style>
