---
// Portada «Façanes». Primer, «Avui a Súria» (Belle Isle): una frase feta amb les dades d'avui
// (agenda i farmàcia de guàrdia) sobre el cel del moment del dia, amb la foto real del poble.
// Després, el que és útil: l'agenda de la setmana (Lentos) amb pròximament a sota, i al costat primers passos;
// els comerços (Union Boulangerie); i «Cap on anem» en la façana verda del turó, en segon pla.
// Mòbil: avui, agenda, primers passos, pròximament, comerços, cap on anem.
import Base from '../layouts/Base.astro';
import CapcaleraSeccio from '../components/CapcaleraSeccio.astro';
import Agenda from '../components/Agenda.astro';
import Proximament from '../components/Proximament.astro';
import ComercosAvui from '../components/ComercosAvui.astro';
import PrimersPassos from '../components/PrimersPassos.astro';
import FotoSuria from '../components/FotoSuria.astro';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';
import { agenda, comercos, consultaMesRecent, idees, passos } from '../lib/dades.ts';
import { dataNumerica } from '../lib/format.ts';
import { fotos } from '../lib/fotos.ts';
import type { DadesAra } from '../lib/ara.ts';

interface Props {
  llengua: Llengua;
}
const { llengua } = Astro.props;
const t = traductor(llengua);
const { setmana, aquestaSetmana, proximament } = await agenda();
const llistaPassos = await passos();
const llistaComercos = await comercos();
const llistaIdees = await idees();
const consultaAgenda = dataNumerica(consultaMesRecent(aquestaSetmana));
const consultaPassos = dataNumerica(consultaMesRecent(llistaPassos));
const senseComercos = llistaComercos.length === 0;

const farmacia = llistaPassos.find((p) => p.guardies.length > 0);
const dadesAra: DadesAra = {
  setmana,
  activitats: aquestaSetmana.map((a) => ({ titol: a.titol[llengua], inici: a.dies.inici, fi: a.dies.fi, hores: a.hores })),
  guardies: farmacia?.guardies.map((g) => ({ farmacia: g.farmacia, desDe: g.desDe, finsA: g.finsA })) ?? [],
};
const enllacos = {
  agenda: '#h-setmana',
  'agenda-oficial': 'https://www.suria.cat/agenda',
  farmacia: '#farmacia',
  'farmacia-oficial': farmacia?.fonts[0]?.url ?? 'https://www.suria.cat/',
};
---
<Base llengua={llengua} pagina="inici">
  <section class="ara" data-moment="mati" aria-labelledby="h-ara">
    <div class="ample ara-dins">
      <div class="ara-text">
        <h2 id="h-ara" class="visually-hidden">{t('ara.titol')}</h2>
        <p class="salutacio" data-ara={JSON.stringify(dadesAra)} data-enllacos={JSON.stringify(enllacos)} data-llengua={llengua}>
          {t('ara.sensejs')}
        </p>
        <p class="font ara-font">{t('ara.font')}</p>
      </div>
      <FotoSuria foto={fotos.vista} llengua={llengua} format="ampla" sizes="(max-width: 900px) 100vw, 40vw" prioritaria />
    </div>
  </section>

  <div class="ample util">
    <section class="setmana" data-facana="ocre" aria-labelledby="h-setmana">
      <CapcaleraSeccio id="h-setmana" titol={t('setmana.titol')} maduresa="En prova" llengua={llengua} />
      <Agenda llengua={llengua} setmana={setmana} activitats={aquestaSetmana} />
      <p class="font peu-seccio"><b>{t('procedencia.font')}:</b> {t('setmana.fontResum', { data: consultaAgenda })}</p>
      <a class="accio" href={urlDe('setmana', llengua)}>{t('tasca.veureSetmana')}</a>
    </section>

    <section class="passos" data-facana="cel" aria-labelledby="h-passos">
      <CapcaleraSeccio id="h-passos" titol={t('passos.titol')} maduresa="En prova" llengua={llengua} compacte />
      <PrimersPassos llengua={llengua} passos={llistaPassos} />
      <p class="font peu-seccio"><b>{t('procedencia.font')}:</b> {t('passos.fontResum', { data: consultaPassos })}</p>
      <a class="accio" href={urlDe('passos', llengua)}>{t('tasca.veurePassos')}</a>
    </section>

    {
      proximament.length > 0 && (
        <section class="proxim" data-facana="ocre" aria-labelledby="h-proximament">
          <CapcaleraSeccio id="h-proximament" titol={t('setmana.proximament')} maduresa="En prova" llengua={llengua} compacte />
          <Proximament llengua={llengua} activitats={proximament} ambTitol={false} nivell={2} />
        </section>
      )
    }

    <section class:list={['menjar', { buida: senseComercos }]} data-facana="teula" aria-labelledby="h-menjar">
      <CapcaleraSeccio id="h-menjar" titol={t('menjar.titol')} maduresa="En prova" llengua={llengua} />
      <ComercosAvui llengua={llengua} comercos={llistaComercos} />
    </section>
  </div>

  <section class="cap" data-facana="turo" aria-labelledby="h-cap">
    <div class="ample cap-dins">
      <div>
        <h2 id="h-cap" class="titol-gran">{t('cap.titol')}</h2>
        <p class="identitat">{t('identitat.text')}</p>
        <p class="font-identitat">{t('identitat.font')}</p>
      </div>
      <div>
        <p>{t('cap.intro')}</p>
        <p class="idea" id="idees-etiqueta">{t('cap.idees')}</p>
        <ul class="idees" aria-labelledby="idees-etiqueta">
          {llistaIdees.map((i) => <li>{i.text[llengua]}</li>)}
        </ul>
        <a class="accio" href={urlDe('cap', llengua)}>{t('nav.cap')}</a>
      </div>
    </div>
  </section>

  <aside class="ample provant" aria-labelledby="h-provant">
    <h2 id="h-provant" class="titol-gran">{t('provant.titol')}</h2>
    <div>
      <p>{t('provant.resum')}</p>
      <a class="accio" href={urlDe('provant', llengua)}>{t('nav.provant')}</a>
    </div>
  </aside>
</Base>

<script>
  import '../scripts/ara.ts';
</script>

<style>
  /* «Avui a Súria»: el cel canvia amb el moment del dia (l'únic moviment de la portada). */
  .ara {
    --cel-a: #d6e1ea;
    --cel-b: #f6e5c0;
    background: linear-gradient(180deg, var(--cel-a) 0%, var(--cel-b) 100%);
    transition:
      --cel-a 1.6s var(--ease),
      --cel-b 1.6s var(--ease);
  }
  .ara[data-moment='tarda'] {
    --cel-a: #cfdbe6;
    --cel-b: #f3d6c4;
  }
  .ara[data-moment='vespre'] {
    --cel-a: #c3cddc;
    --cel-b: #e4d6e3;
  }
  .ara-dins {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-5) clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-block: clamp(1.5rem, 3.2vw, 2.75rem);
  }
  .salutacio {
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-salutacio);
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: pretty;
    max-width: 22em;
  }
  .salutacio :global(a) {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.14em;
    text-decoration-color: rgb(29 37 50 / 0.45);
  }
  .salutacio :global(a:hover) {
    color: var(--tinta);
    text-decoration-color: var(--teula);
  }
  .ara-font {
    margin-top: var(--s-4);
    max-width: 40rem;
  }
  .ara :global(.foto img) {
    aspect-ratio: 16 / 10;
  }

  /* Útil: l'agenda i, a sota, pròximament (la mateixa façana ocre); al costat, primers passos. */
  .util {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-areas:
      'setmana passos'
      'proxim passos'
      'menjar menjar';
    gap: var(--s-8) clamp(1.5rem, 5vw, 5rem);
    padding-top: clamp(1.75rem, 2.5vw, 2.25rem);
    align-items: start;
  }
  .setmana {
    grid-area: setmana;
  }
  .passos {
    grid-area: passos;
  }
  .proxim {
    grid-area: proxim;
  }
  .menjar {
    grid-area: menjar;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(1.5rem, 5vw, 5rem);
    padding-top: var(--s-5);
    border-top: 6px solid var(--teula);
  }
  .peu-seccio {
    margin-top: var(--s-4);
  }
  /* Comerços buits: el missatge honest en gran (una frase, com fa Lentos quan no hi ha dates). */
  .buida :global(.buit) {
    padding-top: 0;
  }

  /* Cap on anem: la façana verda del turó. Les idees, amb filets discontinus i l'etiqueta explícita. */
  .cap {
    margin-top: var(--s-9);
    background: var(--turo);
    color: var(--sobre-turo);
  }
  .cap-dins {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--s-6) clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .cap h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--s-4);
  }
  .identitat {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: 24em;
  }
  .font-identitat {
    margin-top: var(--s-2);
    font-size: var(--t-meta);
    color: var(--sobre-turo-2);
  }
  .cap p {
    max-width: 36em;
  }
  .idea {
    display: inline-block;
    margin-top: var(--s-5);
    padding: 0.05em 0.5em 0.1em;
    border: 1.5px dashed currentColor;
    border-radius: 0.3em;
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--t-small);
  }
  .idees {
    list-style: none;
    margin: var(--s-3) 0 var(--s-2);
    border-top: 1px dashed var(--sobre-turo-2);
  }
  .idees li {
    padding: var(--s-2) 0;
    border-bottom: 1px dashed var(--sobre-turo-2);
    color: var(--sobre-turo-2);
  }
  .cap .accio:hover {
    color: var(--ocre);
  }
  .cap :global(a:focus-visible) {
    outline-color: var(--ocre);
  }

  .provant {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(1.5rem, 5vw, 5rem);
    align-items: baseline;
    padding-top: var(--s-7);
  }
  .provant h2 {
    font-size: clamp(1.75rem, 2.6vw, 2.375rem);
    margin-bottom: var(--s-2);
  }
  .provant p {
    max-width: 38em;
  }

  @media (max-width: 56.25rem) {
    .ara-dins,
    .util,
    .menjar,
    .cap-dins,
    .provant {
      grid-template-columns: minmax(0, 1fr);
    }
    .util {
      grid-template-areas: 'setmana' 'passos' 'proxim' 'menjar';
      row-gap: var(--s-7);
    }
    .ara :global(.foto img) {
      aspect-ratio: 21 / 9;
    }
  }
</style>
