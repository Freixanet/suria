---
// Plantilla de pàgina de tasca: el que és útil primer; fonts i altres tasques al costat (al mòbil, a sota).
import Base from '../layouts/Base.astro';
import CapcaleraSeccio from '../components/CapcaleraSeccio.astro';
import FontsOficials from '../components/FontsOficials.astro';
import AltresTasques from '../components/AltresTasques.astro';
import type { Llengua } from '../i18n/ui.ts';
import type { Pagina } from '../i18n/rutes.ts';
import { facanaDe } from '../lib/facanes.ts';

interface Props {
  llengua: Llengua;
  pagina: Pagina;
  titol: string;
  descripcio: string;
  maduresa: 'Real' | 'En prova' | 'Demo' | 'Idea';
  fonts?: { nom: { ca: string; es: string }; url: string }[];
}
const { llengua, pagina, titol, descripcio, maduresa, fonts = [] } = Astro.props;
---
<Base llengua={llengua} pagina={pagina} titol={titol} descripcio={descripcio}>
  <div class="tasca" data-facana={facanaDe[pagina]}>
    <header class="obertura">
      <div class="ample">
        <CapcaleraSeccio id="titol-pagina" titol={titol} maduresa={maduresa} llengua={llengua} nivell={1} detall={descripcio} classeDetall="entrada" />
      </div>
    </header>
    <div class="ample graella">
      <div class="cos">
        <slot />
      </div>
      <aside class="lateral">
        {fonts.length > 0 && <FontsOficials llengua={llengua} fonts={fonts} />}
        <AltresTasques llengua={llengua} actual={pagina} />
      </aside>
    </div>
  </div>
</Base>

<style>
  /* Obertura de pàgina: una franja del color de la seva façana (la mateixa mostra que a la navegació). */
  .obertura {
    background: var(--f-clar);
    border-top: 6px solid var(--f);
    padding-block: clamp(1.75rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .graella {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    column-gap: clamp(1.5rem, 5vw, 5rem);
    padding-top: clamp(1.5rem, 3vw, 2.75rem);
  }
  /* La columna principal manté la mesura de lectura. */
  .cos {
    min-width: 0;
    max-width: 48rem;
  }
  .lateral {
    display: grid;
    align-content: start;
    gap: var(--s-6);
  }
  @media (min-width: 56.3rem) {
    .lateral {
      position: sticky;
      top: var(--s-5);
      align-self: start;
    }
  }
  @media (max-width: 56.25rem) {
    .graella {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-7);
    }
  }
</style>
