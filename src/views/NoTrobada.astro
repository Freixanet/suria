---
// Pàgina no trobada: en català i en castellà, amb sortides clares cap a les tasques.
import Base from '../layouts/Base.astro';
import { traductor } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';

const ca = traductor('ca');
const es = traductor('es');
const tasques = ['setmana', 'menjar', 'passos'] as const;
const clau = { setmana: 'nav.setmana', menjar: 'nav.menjar', passos: 'nav.passos' } as const;
---
<Base llengua="ca" pagina={null} titol={ca('nofound.titol')}>
  <div class="nf">
    <section aria-labelledby="nf-ca">
      <h1 id="nf-ca" class="titol-serif">{ca('nofound.titol')}</h1>
      <p>{ca('nofound.text')}</p>
      <ul>
        <li><a href={urlDe('inici', 'ca')}>{ca('tasca.inici')}</a></li>
        {tasques.map((x) => <li><a href={urlDe(x, 'ca')}>{ca(clau[x])}</a></li>)}
      </ul>
    </section>
    <section lang="es" aria-labelledby="nf-es">
      <h2 id="nf-es" class="titol-serif">{es('nofound.titol')}</h2>
      <p>{es('nofound.text')}</p>
      <ul>
        <li><a href={urlDe('inici', 'es')}>{es('tasca.inici')}</a></li>
        {tasques.map((x) => <li><a href={urlDe(x, 'es')}>{es(clau[x])}</a></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .nf {
    padding: clamp(1.5rem, 3.5vw, 2.75rem) var(--pad) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--s-7);
    max-width: 64rem;
  }
  h1,
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--s-3);
  }
  ul {
    list-style: none;
    border-top: var(--rule-strong);
    margin-top: var(--s-3);
  }
  li {
    border-bottom: var(--rule-thin);
  }
  a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-display-stack);
    font-weight: 700;
  }
</style>
