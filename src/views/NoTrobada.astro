---
// Pàgina no trobada: en català i en castellà, amb sortides clares cap a les tasques.
import Base from '../layouts/Base.astro';
import { traductor } from '../i18n/ui.ts';
import { urlDe } from '../i18n/rutes.ts';

const ca = traductor('ca');
const es = traductor('es');
const tasques = ['setmana', 'menjar', 'passos'] as const;
const clau = { setmana: 'nav.setmana', menjar: 'nav.menjar', passos: 'nav.passos' } as const;
---
<Base llengua="ca" pagina={null} titol={ca('nofound.titol')}>
  <div class="ample nf">
    <section aria-labelledby="nf-ca">
      <h1 id="nf-ca" class="titol-gran">{ca('nofound.titol')}</h1>
      <p>{ca('nofound.text')}</p>
      <ul>
        <li><a href={urlDe('inici', 'ca')}>{ca('tasca.inici')}</a></li>
        {tasques.map((x) => <li><a href={urlDe(x, 'ca')}>{ca(clau[x])}</a></li>)}
      </ul>
    </section>
    <section lang="es" aria-labelledby="nf-es">
      <h2 id="nf-es" class="titol-gran">{es('nofound.titol')}</h2>
      <p>{es('nofound.text')}</p>
      <ul>
        <li><a href={urlDe('inici', 'es')}>{es('tasca.inici')}</a></li>
        {tasques.map((x) => <li><a href={urlDe(x, 'es')}>{es(clau[x])}</a></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .nf {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) clamp(1.5rem, 5vw, 5rem);
    padding-top: clamp(2rem, 5vw, 4.5rem);
  }
  h1,
  h2 {
    font-size: clamp(2.25rem, 5vw, 4rem);
    margin-bottom: var(--s-4);
  }
  ul {
    list-style: none;
    margin-top: var(--s-4);
  }
  li {
    border-bottom: var(--filet-fi);
  }
  a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--display);
    font-weight: 600;
  }
  @media (max-width: 56.25rem) {
    .nf {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
