---
import { fotos } from '../lib/fotos.ts';
import PaginaTasca from './PaginaTasca.astro';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { provant } from '../i18n/textos-pagines.ts';
import { urlDe } from '../i18n/rutes.ts';

interface Props {
  llengua: Llengua;
}
const { llengua } = Astro.props;
const t = traductor(llengua);
const x = provant[llengua];
const nomTasca = { setmana: t('nav.setmana'), menjar: t('nav.menjar'), passos: t('nav.passos') };
---
<PaginaTasca llengua={llengua} pagina="provant" titol={t('provant.titol')} descripcio={t('provant.descripcio')} maduresa="En prova">
  <p class="intro">{x.intro}</p>
  <section aria-labelledby="h-proves">
    <h2 id="h-proves" class="titol-gran">{x.provesTitol}</h2>
    <ol class="proves">
      {x.proves.map((p) => (
        <li>
          <h3><a href={urlDe(p.tasca, llengua)}>{nomTasca[p.tasca]}</a></h3>
          <p class="pregunta">{p.pregunta}</p>
          <p>{p.com}</p>
        </li>
      ))}
    </ol>
    <p class="durada">{x.durada} {x.decisio}</p>
  </section>
  <section aria-labelledby="h-dades">
    <h2 id="h-dades" class="titol-gran">{x.dadesTitol}</h2>
    <p>{x.dades}</p>
  </section>
  <section aria-labelledby="h-opinar">
    <h2 id="h-opinar" class="titol-gran">{x.opinarTitol}</h2>
    <p>{x.opinar}</p>
  </section>
  <section id="fonts-credits" aria-labelledby="h-fonts-credits">
    <h2 id="h-fonts-credits" class="titol-gran">{llengua === 'ca' ? 'Fonts i crèdits' : 'Fuentes y créditos'}</h2>
    <p>{llengua === 'ca' ? 'Foto de Súria:' : 'Foto de Súria:'} <a href={fotos.vista.original}>Krzysztof Golik, 2022 · Wikimedia Commons</a>. <a href={fotos.vista.llicenciaUrl} rel="license">CC BY-SA 4.0</a>. {llengua === 'ca' ? 'Imatge retallada per adaptar-la a la portada. El contorn del peu és un traçat simplificat d’aquesta fotografia, també sota CC BY-SA 4.0.' : 'Imagen recortada para adaptarla a la portada. El contorno del pie es un trazado simplificado de esta fotografía, también bajo CC BY-SA 4.0.'}</p>
    <p>{llengua === 'ca' ? 'Dades meteorològiques:' : 'Datos meteorológicos:'} <a href="https://www.met.no/">MET Norway · Norwegian Meteorological Institute</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. {llengua === 'ca' ? 'Estimacions horàries de model, arrodonides a graus enters; no una estació municipal.' : 'Estimaciones horarias de modelo, redondeadas a grados enteros; no una estación municipal.'}</p>
    <p>{llengua === 'ca' ? 'Agenda i serveis municipals:' : 'Agenda y servicios municipales:'} <a href="https://www.suria.cat/" hreflang="ca">Ajuntament de Súria</a>. {llengua === 'ca' ? 'Cada activitat enllaça a la seva fitxa original; els serveis enllacen a les fonts oficials.' : 'Cada actividad enlaza a su ficha original; los servicios enlazan a las fuentes oficiales.'}</p>
    <p>{llengua === 'ca' ? 'Horaris interurbans:' : 'Horarios interurbanos:'} <a href="https://www.alsa.es/">ALSA</a>. {llengua === 'ca' ? 'Horaris programats, no seguiment en directe. La vigència es conserva a les dades del projecte.' : 'Horarios programados, no seguimiento en directo. La vigencia se conserva en los datos del proyecto.'}</p>
  </section>
</PaginaTasca>

<style>
  .intro {
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.4;
  }
  section {
    margin-top: var(--s-7);
  }
  h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--s-4);
  }
  #fonts-credits p + p { margin-top: var(--s-4); }
  section > p {
    max-width: 40rem;
  }
  .proves {
    list-style: none;
    border-top: var(--filet-fort);
  }
  .proves li {
    padding-block: var(--s-4);
    border-bottom: var(--filet-fi);
  }
  h3 {
    font-size: var(--t-h3);
  }
  h3 a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .pregunta {
    font-weight: 700;
  }
  .durada {
    margin-top: var(--s-4);
    color: var(--tinta-2);
  }
</style>
