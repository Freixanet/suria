---
import PaginaTasca from './PaginaTasca.astro';
import Idees from '../components/Idees.astro';
import Etiqueta from '../components/Etiqueta.astro';
import FotoSuria from '../components/FotoSuria.astro';
import { traductor, type Llengua } from '../i18n/ui.ts';
import { idees } from '../lib/dades.ts';
import { fotos } from '../lib/fotos.ts';

interface Props {
  llengua: Llengua;
}
const { llengua } = Astro.props;
const t = traductor(llengua);
const llista = await idees();
const escala = [
  { m: 'Real', clau: 'cap.escala.real' },
  { m: 'En prova', clau: 'cap.escala.prova' },
  { m: 'Demo', clau: 'cap.escala.demo' },
  { m: 'Idea', clau: 'cap.escala.idea' },
] as const;
---
<PaginaTasca llengua={llengua} pagina="cap" titol={t('cap.titol')} descripcio={t('cap.descripcio')} maduresa="Idea">
  <div class="cos-cap"><FotoSuria foto={fotos.vista} llengua={llengua} format="ampla" sizes="(max-width: 900px) 100vw, 44rem" prioritaria />
  <p class="identitat">{t('identitat.text')} <span>({t('identitat.font')})</span></p>
  <Idees llengua={llengua} idees={llista} />
  <p class="compromis">{t('cap.compromis')}</p>
  <section class="escala" aria-labelledby="h-escala">
    <h2 id="h-escala">{t('cap.escala.titol')}</h2>
    <dl>
      {escala.map((e) => (
        <div>
          <dt><Etiqueta maduresa={e.m} llengua={llengua} /></dt>
          <dd>{t(e.clau)}</dd>
        </div>
      ))}
    </dl>
  </section>
</div>
</PaginaTasca>

<style>
  .cos-cap :global(.foto) {
    margin-bottom: var(--s-5);
  }
  .identitat {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .identitat span {
    display: block;
    margin-top: var(--s-2);
    font-family: var(--text);
    font-weight: 400;
    font-size: var(--t-meta);
    letter-spacing: 0;
    color: var(--tinta-2);
  }
  .compromis {
    margin-top: var(--s-4);
    font-weight: 700;
  }
  .escala {
    margin-top: var(--s-7);
  }
  h2 {
    font-size: var(--t-h3);
    margin-bottom: var(--s-2);
  }
  dl > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-3);
    border-bottom: var(--filet-fi);
  }
  @media (max-width: 30rem) {
    dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-1);
    }
  }
</style>
